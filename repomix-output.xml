// visualizer.astro — Full-Screen Advanced Scope Page
import '../styles/global.css';
import Visualizer from '../components/Visualizer.astro';
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SS_SCOPE v3.0 | Audio Visualizer</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; width: 100%; height: 100%; background: #000; overflow: hidden; }
      .scope-wrap { width: 100vw; height: 100vh; position: relative; }

      /* Back link */
      #back-link {
        position: fixed; top: 16px; left: 16px; z-index: 100;
        font-size: 9px; font-family: monospace; letter-spacing: 0.4em;
        color: #444; text-decoration: none; text-transform: uppercase;
        transition: color 0.2s;
      }
      #back-link:hover { color: #ffff00; }

      /* Panel collapse toggle */
      #panel-toggle {
        position: fixed; bottom: 16px; right: 16px; z-index: 200;
        font-size: 8px; font-family: monospace; letter-spacing: 0.3em;
        color: #444; background: transparent; border: 1px solid #222;
        padding: 6px 12px; cursor: pointer; text-transform: uppercase;
        transition: all 0.2s;
      }
      #panel-toggle:hover { color: #ffff00; border-color: #ffff00; }

      /* Hide panel */
      body.panel-hidden #control-panel { transform: translateY(100%); transition: transform 0.4s cubic-bezier(0.4,0,0.2,1); }
      #control-panel { transition: transform 0.4s cubic-bezier(0.4,0,0.2,1); }
    </style>
  </head>
  <body>
    <a id="back-link" href="/">← BACK</a>
    <button id="panel-toggle">▲ PANEL</button>
    <div class="scope-wrap">
      <Visualizer isMini={false} color="#ffff00" />
    </div>
    <script>
      const toggle = document.getElementById('panel-toggle');
      toggle?.addEventListener('click', () => {
        document.body.classList.toggle('panel-hidden');
        if (document.body.classList.contains('panel-hidden')) {
          toggle.textContent = '▼ PANEL';
        } else {
          toggle.textContent = '▲ PANEL';
        }
      });
    </script>
  </body>
</html>
</file>

