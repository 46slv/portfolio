<script>
  // 時刻とロード時間の更新ロジック
  setInterval(() => {
    const el = document.getElementById('sys-time');
    if (el) el.innerText = `TIME: ${new Date().toLocaleTimeString('ja-JP', { hour12: false })} JST`;
  }, 1000);
  
  window.addEventListener('load', () => {
    const el = document.getElementById('load-time');
    if (el) el.innerText = `LOAD: ${Math.round(performance.now())}ms`;
  });
</script>
