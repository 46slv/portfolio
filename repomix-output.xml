<file path="src/components/RotaryLogs.astro">
---
// RotaryLogs.astro
interface Log {
  date: string;
  content: string;
  url: string;
}
interface Props {
  logs: Log[];
}
const { logs } = Astro.props;
---
<section class="animate-fade-slide delay-300">
  <h2 class="text-[10px] tracking-[0.3em] font-bold text-zinc-400 uppercase mb-6 border-b border-zinc-900 pb-2">Recent Logs</h2>
  <div class="relative h-[320px]" style="mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);">
    <div id="rotary" class="rotary-viewport absolute inset-0 overflow-y-auto">
      <div id="rotary-dummy" style="height: 100000px;"></div>
      <div id="rotary-list" class="absolute top-0 left-0 w-full">
        {logs.map((log) => (
          <div class="rotary-item absolute w-full">
            <div class="flex gap-4 items-center group">
              <div class="h-1.5 w-1.5 rounded-full bg-[#d0e2f8] shadow-[0_0_8px_rgba(208,226,248,0.4)] group-hover:shadow-[0_0_12px_rgba(208,226,248,0.8)] transition-all"></div>
              <div>
                <div class="text-[10px] font-mono text-zinc-400 mb-1 tracking-wider">{log.date}</div>
                <a href={log.url} target="_blank" class="text-sm tracking-wider text-zinc-300 group-hover:text-[#d0e2f8] transition-all hover:scale-105 origin-left inline-block">
                  {log.content}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const rotary = document.getElementById('rotary') as HTMLElement;
  const list = document.getElementById('rotary-list') as HTMLElement;
  
  if (rotary && list) {
    const items = Array.from(list.children) as HTMLElement[];
    const itemHeight = 80;
    const totalHeight = items.length * itemHeight;
    const offset = itemHeight; 
    const centerPos = Math.floor(50000 / itemHeight) * itemHeight;
    rotary.scrollTop = centerPos;

    let isInteracting = false;
    let snapTimeout: number;

    const updateItems = () => {
      const currentScroll = rotary.scrollTop;
      const scrollY = currentScroll - centerPos;
      items.forEach((item, i) => {
        const basePos = i * itemHeight;
        const pos = basePos - scrollY;
        const wrappedPos = (((pos + offset) % totalHeight) + totalHeight) % totalHeight - offset;
        item.style.transform = `translateY(${currentScroll + wrappedPos}px)`;
      });
    };

    const snapToCenter = () => {
      if (isInteracting) return;
      const target = Math.round(rotary.scrollTop / itemHeight) * itemHeight;
      rotary.scrollTo({ top: target, behavior: 'smooth' });
    };

    rotary.addEventListener('scroll', () => {
      updateItems();
      clearTimeout(snapTimeout);
      if (!isInteracting) snapTimeout = window.setTimeout(snapToCenter, 500);
    }, { passive: true });

    const startInteraction = () => { isInteracting = true; clearTimeout(snapTimeout); };
    const endInteraction = () => { isInteracting = false; snapTimeout = window.setTimeout(snapToCenter, 500); };

    rotary.addEventListener('mousedown', startInteraction);
    window.addEventListener('mouseup', endInteraction);
    rotary.addEventListener('touchstart', startInteraction);
    window.addEventListener('touchend', endInteraction);
    rotary.addEventListener('wheel', () => {
      startInteraction();
      clearTimeout((rotary as any).wheelTimer);
      (rotary as any).wheelTimer = setTimeout(endInteraction, 150);
    }, { passive: true });

    updateItems();
  }
</script>
</file>

<file path="src/components/Visualizer.astro">
---
// Visualizer.astro
interface Props {
  isMini?: boolean;
}
const { isMini = false } = Astro.props;
---
<div class={`visualizer-container relative w-full h-full ${isMini ? 'min-h-[60px]' : 'min-h-[200px]'}`}>
  <canvas id="visualizer-canvas" class="w-full h-full"></canvas>
  
  {!isMini && (
    <div id="vis-controls" class="absolute bottom-4 left-4 flex gap-4 z-20 bg-black/80 p-2 border border-zinc-800">
      <div class="flex flex-col gap-1">
        <label class="text-[8px] text-zinc-500 uppercase">Input Device</label>
        <select id="audio-input" class="bg-transparent text-[10px] text-zinc-300 outline-none w-40"></select>
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-[8px] text-zinc-500 uppercase">Mode</label>
        <select id="vis-mode" class="bg-transparent text-[10px] text-zinc-300 outline-none">
          <option value="waveform">Waveform</option>
          <option value="oscilloscope">Oscilloscope</option>
        </select>
      </div>
    </div>
  )}
</div>

<script>
  let audioContext: AudioContext;
  let analyser: AnalyserNode;
  let source: MediaStreamAudioSourceNode;
  
  const canvas = document.getElementById('visualizer-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const inputSelect = document.getElementById('audio-input') as HTMLSelectElement;
  const modeSelect = document.getElementById('vis-mode') as HTMLSelectElement;

  function resize() {
    canvas.width = canvas.clientWidth * window.devicePixelRatio;
    canvas.height = canvas.clientHeight * window.devicePixelRatio;
  }
  window.addEventListener('resize', resize);
  resize();

  async function initAudio(deviceId?: string) {
    if (audioContext) audioContext.close();
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ 
        audio: deviceId ? { deviceId: { exact: deviceId } } : true 
      });
      audioContext = new AudioContext();
      analyser = audioContext.createAnalyser();
      analyser.fftSize = 2048;
      source = audioContext.createMediaStreamSource(stream);
      source.connect(analyser);
      draw();
    } catch (e) { console.error("Audio init failed", e); }
  }

  function draw() {
    requestAnimationFrame(draw);
    const bufferLength = analyser.frequencyBinCount;
    const dataArray = new Uint8Array(bufferLength);
    const mode = modeSelect?.value || 'waveform';

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.lineWidth = 2 * window.devicePixelRatio;
    ctx.strokeStyle = '#d0e2f8';
    ctx.beginPath();

    if (mode === 'waveform') {
      analyser.getByteTimeDomainData(dataArray);
      const sliceWidth = canvas.width / bufferLength;
      let x = 0;
      for (let i = 0; i < bufferLength; i++) {
        const v = dataArray[i] / 128.0;
        const y = v * canvas.height / 2;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
        x += sliceWidth;
      }
    } else if (mode === 'oscilloscope') {
      analyser.getByteTimeDomainData(dataArray);
      // X-Y表示のシミュレーション
      for (let i = 0; i < bufferLength; i += 2) {
        const x = (dataArray[i] / 128.0 - 1) * canvas.width * 0.4 + canvas.width / 2;
        const y = (dataArray[i+1] / 128.0 - 1) * canvas.height * 0.4 + canvas.height / 2;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
    }
    ctx.stroke();
  }

  navigator.mediaDevices.enumerateDevices().then(devices => {
    if(!inputSelect) return;
    devices.filter(d => d.kind === 'audioinput').forEach(d => {
      const opt = document.createElement('option');
      opt.value = d.deviceId;
      opt.text = d.label || `Device ${inputSelect.length + 1}`;
      inputSelect.appendChild(opt);
    });
  });

  inputSelect?.addEventListener('change', () => initAudio(inputSelect.value));
  window.addEventListener('click', () => { if(!audioContext) initAudio(); }, { once: true });
</script>
</file>

