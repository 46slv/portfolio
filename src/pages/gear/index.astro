---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allGear =
  await getCollection('gear');

const groups =
  allGear.reduce<Record<string, typeof allGear>>(
    (acc, item) => {
      const key =
        item.data.category;

      acc[key] =
        acc[key] ?? [];

      acc[key].push(item);

      return acc;
    },
    {}
  );
---

<BaseLayout title="SS_Gear | Equipment">
  <main class="flex-grow">
    <section class="mb-14 animate-fade-slide">
      <a href="/" class="text-[10px] tracking-[0.28em] text-zinc-600 hover:text-zinc-300 transition-colors">BACK</a>
      <h1 class="mt-8 text-4xl md:text-6xl font-bold text-white tracking-tight">Gear</h1>
      <p class="mt-5 max-w-2xl text-sm leading-loose text-zinc-500">
        Equipment, software, and production modules kept as content collection entries.
      </p>
    </section>

    <section class="space-y-12 animate-fade-slide delay-100">
      {Object.entries(groups).map(([category, items]) => (
        <div>
          <h2 class="text-[10px] tracking-[0.3em] font-bold text-zinc-500 uppercase mb-5 border-b border-zinc-900 pb-2">{category}</h2>
          <div class="divide-y divide-zinc-900 border border-zinc-900 bg-zinc-950/35">
            {items.map(item => {
              const title =
                (item.body ?? item.id)
                  .replace(/^#\s*/m, '')
                  .trim();

              const md =
`---
category: ${item.data.category}
maker: ${item.data.maker}
status: ${item.data.status}
tags: [${item.data.tags.join(', ')}]
---
# ${title}`;

              return (
                <article class="gear-item grid gap-4 md:grid-cols-[1fr_auto] md:items-center p-5" data-md={md}>
                  <div>
                    <h3 class="text-sm font-bold text-zinc-100 tracking-wider">{title}</h3>
                    <p class="mt-2 text-[10px] uppercase tracking-[0.22em] text-zinc-600">{item.data.maker} / {item.data.status} / {item.data.tags.join(', ')}</p>
                  </div>
                  <button class="copy-md border border-zinc-800 px-4 py-3 text-[10px] tracking-[0.24em] text-zinc-400 hover:border-[#d0e2f8] hover:text-[#d0e2f8] transition-colors">[COPY MD]</button>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </section>
  </main>

  <script>
    document.querySelectorAll('.gear-item')
      .forEach((item) => {
        const button =
          item.querySelector('.copy-md') as HTMLButtonElement | null;

        if (!button) {
          return;
        }

        button.addEventListener(
          'click',
          async () => {
            const value =
              (item as HTMLElement).dataset.md;

            if (!value) {
              return;
            }

            await navigator.clipboard.writeText(value);

            const original =
              button.textContent ?? '[COPY MD]';

            button.textContent =
              'COPIED!';

            window.setTimeout(
              () => {
                button.textContent =
                  original;
              },
              1200
            );
          }
        );
      });
  </script>
</BaseLayout>
