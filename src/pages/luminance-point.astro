---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Luminance Glyph Instances | SS_Portfolio"
  showShell={false}
  bodyClass="bg-[#080808] text-zinc-300 font-sans antialiased overflow-hidden"
>
  <main class="point-demo" aria-label="Luminance driven glyph instance prototype">
    <canvas id="point-field" aria-hidden="true"></canvas>

    <div class="demo-meta" aria-hidden="true">
      <span>GLYPH INSTANCES / LUMINANCE FIELD</span>
      <span id="glyph-readout">INSTANCE: POINT</span>
    </div>

    <section class="demo-nav" aria-label="Prototype navigation">
      <p class="demo-index">SS_PORTFOLIO / INSTANCE TEST</p>
      <div class="demo-words">
        <button type="button" data-point-word>WORKS</button>
        <button type="button" data-point-word>REEL</button>
        <button type="button" data-point-word>ABOUT</button>
        <button type="button" data-point-word>CONTACT</button>
      </div>
      <p class="demo-note">hover a letter / tap on touch</p>
    </section>

    <div class="demo-legend" aria-hidden="true">
      <span>LUMINANCE → SCALE</span>
      <span>LUMINANCE → OPACITY</span>
      <span>POINT → GLYPH INSTANCE</span>
    </div>
  </main>

  <style is:global>
    #cursor-light {
      display: none !important;
    }

    .point-demo {
      position: relative;
      width: 100vw;
      min-height: 100svh;
      overflow: hidden;
      background: #080808;
      isolation: isolate;
    }

    #point-field {
      position: fixed;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .demo-meta,
    .demo-legend {
      position: fixed;
      z-index: 2;
      display: flex;
      gap: 18px;
      color: rgba(255,255,255,.34);
      font: 500 10px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .14em;
      pointer-events: none;
    }

    .demo-meta {
      top: 20px;
      left: 24px;
      right: 24px;
      justify-content: space-between;
    }

    .demo-legend {
      right: 24px;
      bottom: 20px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .demo-nav {
      position: relative;
      z-index: 2;
      min-height: 100svh;
      display: grid;
      align-content: center;
      justify-items: start;
      padding: clamp(28px, 6vw, 96px);
    }

    .demo-index,
    .demo-note {
      margin: 0;
      color: rgba(255,255,255,.32);
      font: 500 10px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .16em;
      text-transform: uppercase;
    }

    .demo-words {
      display: grid;
      gap: clamp(3px, .45vw, 8px);
      margin: 26px 0 22px;
    }

    [data-point-word] {
      appearance: none;
      border: 0;
      padding: 0;
      background: transparent;
      color: rgba(255,255,255,.88);
      font: 600 clamp(36px, 6.2vw, 92px)/.92 Arial, Helvetica, sans-serif;
      letter-spacing: -.055em;
      text-align: left;
      cursor: default;
    }

    .point-letter {
      display: inline-block;
      transition: opacity 140ms linear, filter 140ms linear;
    }

    .point-letter[data-near="true"] {
      filter: brightness(1.25);
    }

    [data-point-word]:has(.point-letter[data-near="true"]) .point-letter:not([data-near="true"]) {
      opacity: .28;
    }

    .demo-note {
      opacity: .62;
    }

    @media (max-width: 700px) {
      .demo-meta {
        top: 16px;
        left: 16px;
        right: 16px;
      }

      .demo-legend {
        right: 16px;
        bottom: 14px;
        left: 16px;
        justify-content: flex-start;
        font-size: 8px;
      }

      .demo-nav {
        padding: 24px 18px;
      }

      [data-point-word] {
        font-size: clamp(42px, 16vw, 72px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .point-letter {
        transition: none;
      }
    }
  </style>

  <script>
    const canvas = document.querySelector('#point-field');
    const glyphReadout = document.querySelector('#glyph-readout');
    const words = [...document.querySelectorAll('[data-point-word]')];

    if (!(canvas instanceof HTMLCanvasElement)) {
      throw new Error('Point field canvas is missing.');
    }

    const ctx = canvas.getContext('2d', { alpha: false });

    if (!ctx) {
      throw new Error('Canvas 2D context is unavailable.');
    }

    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));

    const smoothstep = (edge0, edge1, value) => {
      const t = clamp((value - edge0) / Math.max(0.0001, edge1 - edge0));
      return t * t * (3 - 2 * t);
    };

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pointer = { x: -1000, y: -1000, present: false, lockedChar: '' };

    let width = 1;
    let height = 1;
    let dpr = 1;
    let spacing = 17;
    let points = [];
    let letterMetrics = [];
    let currentChar = '';
    let previousChar = '';
    let glyphTransition = 1;
    let hoverStrength = 0;
    let lastTime = performance.now();

    words.forEach((word) => {
      const text = word.textContent ?? '';
      word.setAttribute('aria-label', text);
      word.textContent = '';

      [...text].forEach((char) => {
        const span = document.createElement('span');
        span.className = 'point-letter';
        span.dataset.char = char;
        span.setAttribute('aria-hidden', 'true');
        span.textContent = char;
        word.append(span);

        span.addEventListener('pointerdown', (event) => {
          pointer.lockedChar = char;
          pointer.x = event.clientX;
          pointer.y = event.clientY;
          pointer.present = true;
          setGlyph(char);
        });
      });
    });

    function rebuildLetterMetrics() {
      letterMetrics = [...document.querySelectorAll('.point-letter')].map((node) => {
        const rect = node.getBoundingClientRect();

        return {
          node,
          char: node.dataset.char ?? '',
          rect,
        };
      });
    }

    function distanceToRect(x, y, rect) {
      const dx = Math.max(rect.left - x, 0, x - rect.right);
      const dy = Math.max(rect.top - y, 0, y - rect.bottom);
      return Math.hypot(dx, dy);
    }

    function hash01(value) {
      const x = Math.sin(value * 91.3458) * 47453.5453;
      return x - Math.floor(x);
    }

    function sourceLuminance(point, time) {
      const nx = point.x / width;
      const ny = point.y / height;
      const t = time * 0.00005;

      const waveA = Math.sin((nx * 1.55 + ny * 0.58 + t * 1.08) * Math.PI * 2);
      const waveB = Math.sin((nx * -0.76 + ny * 2.05 - t * 0.68) * Math.PI * 2);
      const waveC = Math.cos((nx * 2.35 - ny * 1.04 + t * 0.37) * Math.PI * 2);

      const c1x = 0.16 + Math.sin(t * 1.25) * 0.12;
      const c1y = 0.31 + Math.cos(t * 0.82) * 0.15;
      const c2x = 0.76 + Math.cos(t * 0.66) * 0.15;
      const c2y = 0.64 + Math.sin(t * 1.02) * 0.17;
      const c3x = 0.49 + Math.sin(t * 0.48 + 2.3) * 0.18;
      const c3y = 0.22 + Math.cos(t * 0.57 + 0.9) * 0.12;

      const dx1 = nx - c1x;
      const dy1 = ny - c1y;
      const dx2 = nx - c2x;
      const dy2 = ny - c2y;
      const dx3 = nx - c3x;
      const dy3 = ny - c3y;

      const blob1 = Math.exp(-(dx1 * dx1 * 12.5 + dy1 * dy1 * 10.5));
      const blob2 = Math.exp(-(dx2 * dx2 * 8.5 + dy2 * dy2 * 12.5));
      const blob3 = Math.exp(-(dx3 * dx3 * 16.0 + dy3 * dy3 * 10.0));

      const drift = waveA * 0.08 + waveB * 0.05 + waveC * 0.04;
      const seedBias = (point.bias - 0.5) * 0.045;

      return clamp(
        0.015 +
        drift +
        blob1 * 0.24 +
        blob2 * 0.34 +
        blob3 * 0.16 +
        seedBias
      );
    }

    function shapeGlyphLuminance(luminance) {
      const gated = Math.max(0, luminance - 0.12);
      const normalized = clamp(gated / 0.88);
      return Math.pow(normalized, 1.45);
    }

    function resize() {
      width = Math.max(1, window.innerWidth);
      height = Math.max(1, window.innerHeight);
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      spacing = width < 700 ? 15 : clamp(width / 88, 16, 21);

      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      points = [];
      const offsetX = (width % spacing) * 0.5;
      const offsetY = (height % spacing) * 0.5;
      let index = 0;

      for (let y = offsetY; y <= height; y += spacing) {
        for (let x = offsetX; x <= width; x += spacing) {
          points.push({
            x,
            y,
            bias: hash01(index + 17),
            scale: 0.45,
            alpha: 0.2,
            scaleVelocity: 0,
            alphaVelocity: 0,
          });
          index += 1;
        }
      }

      requestAnimationFrame(rebuildLetterMetrics);
    }

    function setGlyph(char) {
      if (!char || char === currentChar) {
        return;
      }

      previousChar = currentChar;
      currentChar = char;
      glyphTransition = 0;

      if (glyphReadout) {
        glyphReadout.textContent = 'INSTANCE: ' + char;
      }
    }

    function updateHoverTarget() {
      letterMetrics.forEach(({ node }) => node.removeAttribute('data-near'));

      if (!pointer.present || letterMetrics.length === 0) {
        hoverStrength += (0 - hoverStrength) * (prefersReducedMotion ? 0.32 : 0.11);

        if (hoverStrength < 0.01 && glyphReadout) {
          glyphReadout.textContent = 'INSTANCE: POINT';
        }

        return;
      }

      let nearest = null;
      let nearestDistance = Infinity;

      for (const metric of letterMetrics) {
        const distance = distanceToRect(pointer.x, pointer.y, metric.rect);

        if (distance < nearestDistance) {
          nearestDistance = distance;
          nearest = metric;
        }
      }

      const radius = width < 700 ? 82 : 118;
      const targetStrength = 1 - smoothstep(0, radius, nearestDistance);
      hoverStrength += (targetStrength - hoverStrength) * (prefersReducedMotion ? 0.34 : 0.16);

      if (nearest && targetStrength > 0.015) {
        nearest.node.dataset.near = 'true';
        setGlyph(pointer.lockedChar || nearest.char);
      }
    }

    function drawPoint(point, alpha, scale) {
      if (alpha <= 0.003) {
        return;
      }

      const radius = Math.max(0.3, spacing * 0.07 * (0.65 + scale * 0.9));
      ctx.globalAlpha = alpha;
      ctx.fillStyle = '#f4f4f5';
      ctx.beginPath();
      ctx.arc(point.x, point.y, radius, 0, Math.PI * 2);
      ctx.fill();
    }

    function drawGlyph(point, char, alpha, scale) {
      if (!char || alpha <= 0.003) {
        return;
      }

      const fontSize = Math.max(5, spacing * (0.34 + scale * 0.52));
      ctx.globalAlpha = alpha;
      ctx.fillStyle = '#f4f4f5';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = '600 ' + fontSize + 'px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
      ctx.fillText(char, point.x, point.y + fontSize * 0.03);
    }

    function draw(now) {
      const dt = Math.min(34, now - lastTime);
      lastTime = now;

      updateHoverTarget();

      const transitionSpeed = prefersReducedMotion ? 0.28 : 0.064;
      glyphTransition = clamp(glyphTransition + transitionSpeed * (dt / 16.67));
      const glyphEase = smoothstep(0, 1, glyphTransition);

      ctx.fillStyle = '#080808';
      ctx.fillRect(0, 0, width, height);

      const spring = prefersReducedMotion ? 0.34 : 0.12;
      const damping = prefersReducedMotion ? 0.44 : 0.76;

      for (const point of points) {
        const rawLuminance = sourceLuminance(point, now);
        const glyphLuminance = shapeGlyphLuminance(rawLuminance);
        const instanceMix = smoothstep(0.04, 0.92, hoverStrength);

        const pointScale = 0.42 + rawLuminance * 0.58;
        const pointOpacity = 0.035 + Math.pow(rawLuminance, 0.9) * 0.16;

        const glyphScale = 0.10 + glyphLuminance * 1.65;
        const glyphOpacity = glyphLuminance < 0.015
          ? 0
          : 0.025 + glyphLuminance * 0.78;

        const targetScale = pointScale * (1 - instanceMix) + glyphScale * instanceMix;
        const targetAlpha = pointOpacity * (1 - instanceMix) + glyphOpacity * instanceMix;

        point.scaleVelocity = (point.scaleVelocity + (targetScale - point.scale) * spring) * damping;
        point.alphaVelocity = (point.alphaVelocity + (targetAlpha - point.alpha) * spring) * damping;
        point.scale += point.scaleVelocity;
        point.alpha += point.alphaVelocity;

        const pointAlpha = point.alpha * (1 - instanceMix);
        const glyphAlpha = point.alpha * instanceMix;

        drawPoint(point, pointAlpha, point.scale);

        if (previousChar && glyphEase < 0.999) {
          drawGlyph(point, previousChar, glyphAlpha * (1 - glyphEase), point.scale);
        }

        drawGlyph(point, currentChar, glyphAlpha * glyphEase, point.scale);
      }

      ctx.globalAlpha = 1;
      requestAnimationFrame(draw);
    }

    window.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') {
        return;
      }

      pointer.x = event.clientX;
      pointer.y = event.clientY;
      pointer.present = true;
      pointer.lockedChar = '';
    }, { passive: true });

    window.addEventListener('pointerleave', () => {
      if (!pointer.lockedChar) {
        pointer.present = false;
      }
    });

    window.addEventListener('resize', resize);

    resize();
    requestAnimationFrame(draw);
  </script>
</BaseLayout>
