---
import { logs } from '../data/logs';
---

<section class="animate-fade-slide delay-300">
  <h2 class="text-[10px] tracking-[0.3em] font-bold text-zinc-400 uppercase mb-6 border-b border-zinc-900 pb-2">Recent Logs</h2>
  <div class="relative h-[320px]" style="mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);">
    <div id="rotary" class="rotary-viewport absolute inset-0 overflow-y-auto">
      <div id="rotary-dummy" style="height: 100000px;"></div>
      <div id="rotary-list" class="absolute top-0 left-0 w-full">
        {logs.map((log) => (
          <div class="rotary-item absolute w-full">
            <div class="flex gap-4 items-center group">
              <div class="h-1.5 w-1.5 rounded-full bg-[#d0e2f8] shadow-[0_0_8px_rgba(208,226,248,0.4)] group-hover:shadow-[0_0_12px_rgba(208,226,248,0.8)] transition-all"></div>
              <div>
                <div class="text-[10px] font-mono text-zinc-400 mb-1 tracking-wider">{log.date}</div>
                <a href={log.url} target="_blank" rel="noopener noreferrer" class="text-sm tracking-wider text-zinc-300 group-hover:text-[#d0e2f8] transition-all hover:scale-105 origin-left inline-block">
                  {log.content}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const rotary =
    document.getElementById('rotary') as HTMLElement | null;

  const list =
    document.getElementById('rotary-list') as HTMLElement | null;

  if (rotary && list && list.children.length > 0) {
    const items =
      Array.from(list.children) as HTMLElement[];

    const itemHeight =
      80;

    const totalHeight =
      items.length * itemHeight;

    const offset =
      itemHeight;

    const centerPos =
      Math.floor(50000 / itemHeight) * itemHeight;

    rotary.scrollTop =
      centerPos;

    let isInteracting =
      false;

    let snapTimeout:
      number | undefined;

    let wheelTimer:
      number | undefined;

    const updateItems = () => {
      const currentScroll =
        rotary.scrollTop;

      const scrollY =
        currentScroll - centerPos;

      items.forEach((item, i) => {
        const basePos =
          i * itemHeight;

        const pos =
          basePos - scrollY;

        const wrappedPos =
          (((pos + offset) % totalHeight) + totalHeight) % totalHeight - offset;

        item.style.transform =
          `translateY(${currentScroll + wrappedPos}px)`;
      });
    };

    const snapToCenter = () => {
      if (isInteracting) {
        return;
      }

      const target =
        Math.round(rotary.scrollTop / itemHeight) * itemHeight;

      rotary.scrollTo({
        top: target,
        behavior: 'smooth'
      });
    };

    const startInteraction = () => {
      isInteracting =
        true;

      if (snapTimeout !== undefined) {
        window.clearTimeout(snapTimeout);
      }
    };

    const endInteraction = () => {
      isInteracting =
        false;

      snapTimeout =
        window.setTimeout(
          snapToCenter,
          500
        );
    };

    rotary.addEventListener(
      'scroll',
      () => {
        updateItems();

        if (snapTimeout !== undefined) {
          window.clearTimeout(snapTimeout);
        }

        if (!isInteracting) {
          snapTimeout =
            window.setTimeout(
              snapToCenter,
              500
            );
        }
      },
      { passive: true }
    );

    rotary.addEventListener(
      'mousedown',
      startInteraction
    );

    window.addEventListener(
      'mouseup',
      endInteraction
    );

    rotary.addEventListener(
      'touchstart',
      startInteraction,
      { passive: true }
    );

    window.addEventListener(
      'touchend',
      endInteraction
    );

    rotary.addEventListener(
      'wheel',
      () => {
        startInteraction();

        if (wheelTimer !== undefined) {
          window.clearTimeout(wheelTimer);
        }

        wheelTimer =
          window.setTimeout(
            endInteraction,
            150
          );
      },
      { passive: true }
    );

    updateItems();
  }
</script>
