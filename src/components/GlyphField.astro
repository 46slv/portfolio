<canvas id="glyph-field" aria-hidden="true"></canvas>

<style>
  #glyph-field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }
</style>

<script>
  import { mountGlyphField } from '../scripts/glyph-field';

  const canvas = document.getElementById('glyph-field');
  if (canvas instanceof HTMLCanvasElement) mountGlyphField(canvas);
</script>
