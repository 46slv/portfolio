---
import Visualizer from './Visualizer.astro';

interface Props {
  name: string;
  jpName: string;
}
const { name, jpName } = Astro.props;
---
<header class="flex justify-between items-end mb-12 animate-fade-slide">
  <div class="text-[10px] tracking-[0.4em] font-black text-white uppercase opacity-50 pb-1">
    SS_Portfolio v2.05
  </div>

  <div class="flex-grow mx-12 h-8 border-b border-zinc-900/50 relative group overflow-hidden">
    <a href="/visualizer" class="block w-full h-full" title="Open Fullscreen Scope">
      <Visualizer isMini={true} />
      <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity duration-300">
        <span class="text-[8px] text-[#ffff00] tracking-[0.5em] font-bold">CLICK TO EXPAND SCOPE</span>
      </div>
    </a>
  </div>

  <div class="text-[10px] tracking-widest uppercase font-mono text-right space-y-1">
    <div class="flex items-center justify-end gap-2">
      Status: <span class="text-green-500 animate-pulse">ONLINE</span>
    </div>
    <div id="sys-time" class="text-zinc-500">TIME: --:--:--</div>
    <div id="load-time" class="text-zinc-600">LOAD: ---ms</div>
  </div>
</header>

<div class="border-b border-zinc-900 pb-8 mb-12 animate-fade-slide delay-100">
  <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
    {name}
    <span class="text-zinc-600 font-light text-xl md:text-2xl italic ml-4">{jpName}</span>
  </h1>
</div>

<script>
  // 時刻とロード時間の更新ロジック
  setInterval(() => {
    const el = document.getElementById('sys-time');
    if (el) el.innerText = `TIME: ${new Date().toLocaleTimeString('ja-JP', { hour12: false })} JST`;
  }, 1000);
  
  window.addEventListener('load', () => {
    const el = document.getElementById('load-time');
    if (el) el.innerText = `LOAD: ${Math.round(performance.now())}ms`;
  });
</script>