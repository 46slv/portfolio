---
// src/components/VisualizerMini.astro
// Lightweight Header Scope

const {
  color = "#d8ff72",
  height = 72
} = Astro.props;
---

<div
  class="mini-viz"
  style={`height:${height}px`}
>
  <canvas id="mini-scope"></canvas>
</div>

<style>
  .mini-viz {
    position: relative;

    width: 100%;
    overflow: hidden;

    pointer-events: none;

    background:
      linear-gradient(
        to bottom,
        rgba(255,255,255,0.012),
        rgba(255,255,255,0)
      );
  }

  #mini-scope {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    display: block;
  }
</style>

<script define:vars={{ color }}>
  import { AudioEngine }
  from "../lib/audio/AudioEngine";

  const canvas =
    document.getElementById(
      "mini-scope"
    );

  const ctx =
    canvas.getContext("2d");

  let width = 0;
  let height = 0;

  const engine =
    new AudioEngine();

  function resize() {
    const rect =
      canvas.getBoundingClientRect();

    width =
      canvas.width =
      rect.width * devicePixelRatio;

    height =
      canvas.height =
      rect.height * devicePixelRatio;
  }

  resize();

  window.addEventListener(
    "resize",
    resize
  );

  async function boot() {
    await engine.initInput();
  }

  function clearFrame() {
    ctx.fillStyle =
      "rgba(0,0,0,0.08)";

    ctx.fillRect(
      0,
      0,
      width,
      height
    );
  }

  function drawGrid() {
    ctx.strokeStyle =
      "rgba(255,255,255,0.025)";

    ctx.lineWidth = 1;

    const step = width / 8;

    for (
      let x = 0;
      x < width;
      x += step
    ) {
      ctx.beginPath();

      ctx.moveTo(x, 0);
      ctx.lineTo(x, height);

      ctx.stroke();
    }
  }

  function drawWave() {
    const data =
      engine.getTimeData();

    ctx.beginPath();

    for (
      let i = 0;
      i < data.length;
      i++
    ) {
      const x =
        (i / data.length) * width;

      const y =
        height / 2 +
        ((data[i] - 128) / 128) *
        height *
        0.3;

      if (i === 0) {
        ctx.moveTo(x, y);
      } else {
        ctx.lineTo(x, y);
      }
    }

    ctx.strokeStyle = color;

    ctx.lineWidth = 2;

    ctx.shadowBlur = 12;
    ctx.shadowColor = color;

    ctx.stroke();

    ctx.shadowBlur = 0;
  }

  function render() {
    requestAnimationFrame(render);

    clearFrame();

    drawGrid();

    drawWave();
  }

  render();

  boot();
</script>