---
// src/components/VisualizerMini.astro

const {
  color = "#d8ff72"
} = Astro.props;
---

<canvas class="mini-viz" aria-hidden="true"></canvas>

<style>
  .mini-viz {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.72;
  }
</style>

<script define:vars={{ color }}>
  const previous =
    document.currentScript
      ?.previousElementSibling;

  const canvas =
    previous instanceof HTMLCanvasElement
      ? previous
      : document.querySelector(
          ".mini-viz"
        );

  if (canvas instanceof HTMLCanvasElement) {
    const ctx =
      canvas.getContext("2d");

    let width = 0;
    let height = 0;
    let tick = 0;

    const dpr = () =>
      window.devicePixelRatio || 1;

    function resize() {
      const scale = dpr();

      width =
        canvas.clientWidth *
        scale;

      height =
        canvas.clientHeight *
        scale;

      canvas.width =
        width;

      canvas.height =
        height;
    }

    function draw() {
      if (!ctx)
        return;

      tick += 0.022;

      ctx.clearRect(
        0,
        0,
        width,
        height
      );

      ctx.save();

      ctx.globalAlpha =
        0.16;

      ctx.strokeStyle =
        color;

      ctx.lineWidth =
        Math.max(
          1,
          dpr()
        );

      ctx.beginPath();
      ctx.moveTo(0, height / 2);
      ctx.lineTo(width, height / 2);
      ctx.stroke();

      ctx.globalAlpha =
        0.92;

      ctx.lineWidth =
        Math.max(
          1.15,
          1.35 * dpr()
        );

      ctx.shadowBlur =
        7 * dpr();

      ctx.shadowColor =
        color;

      ctx.beginPath();

      const points = 96;

      for (
        let i = 0;
        i <= points;
        i++
      ) {
        const ratio =
          i / points;

        const x =
          ratio *
          width;

        const envelope =
          Math.sin(
            Math.PI * ratio
          );

        const wave =
          Math.sin(
            ratio * Math.PI * 8 +
            tick * 3.2
          ) * 0.62 +
          Math.sin(
            ratio * Math.PI * 17 -
            tick * 2.1
          ) * 0.22;

        const y =
          height / 2 +
          wave *
          envelope *
          height *
          0.28;

        if (i === 0) {
          ctx.moveTo(x, y);
        } else {
          ctx.lineTo(x, y);
        }
      }

      ctx.stroke();
      ctx.restore();

      requestAnimationFrame(draw);
    }

    resize();

    window.addEventListener(
      "resize",
      resize
    );

    requestAnimationFrame(draw);
  }
</script>
