---
import profileSource from '../../PROFILE.md?raw';

function extractSection(source: string, heading: string): string {
  const lines = source.split(/\r?\n/);
  const startIndex = lines.findIndex((line) => line.trim() === `## ${heading}`);

  if (startIndex === -1) {
    return '';
  }

  const sectionLines: string[] = [];

  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];

    if (line.startsWith('## ')) {
      break;
    }

    sectionLines.push(line);
  }

  return sectionLines.join('\n').trim();
}

function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderBioText(text: string, lang: 'en' | 'ja'): string {
  const linkClass =
    lang === 'en'
      ? 'text-zinc-300 hover:text-white underline underline-offset-4 decoration-zinc-700 transition-all hover:scale-105 inline-block origin-left'
      : 'hover:text-zinc-400 underline underline-offset-4 decoration-zinc-800 transition-all hover:scale-105 inline-block origin-left';

  return escapeHtml(text).replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
    (_match, label: string, href: string) =>
      `<a href="${href}" target="_blank" rel="noopener noreferrer" class="${linkClass}">${label}</a>`
  );
}

const enText = extractSection(profileSource, 'English');
const jaText = extractSection(profileSource, 'Japanese');
---

<section class="mb-24">
  <div class="focus-container space-y-8 text-sm md:text-base leading-loose max-w-3xl font-light animate-fade-slide delay-200">
    <p class="text-zinc-400 dim-text" set:html={renderBioText(enText, 'en')} />
    <p class="text-zinc-600 italic dim-text" set:html={renderBioText(jaText, 'ja')} />
  </div>
</section>
