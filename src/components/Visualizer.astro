---
interface Props {
  isMini?: boolean;
  color?: string;
}

interface KnobDefinition {
  id: string;
  label: string;
  value: string;
  min: string;
  max: string;
  fmt: string;
  bipolar?: string;
}

const {
  isMini = false,
  color = '#36ff72'
} = Astro.props;

const sharedKnobs: KnobDefinition[] = [
  { id: 'volume', label: 'Monitor', value: '0', min: '0', max: '1', fmt: 'pct' },
  { id: 'speed', label: 'Motion', value: '1', min: '0.5', max: '8', fmt: 'x1' },
  { id: 'scale', label: 'Size', value: '1', min: '0.1', max: '3', fmt: 'x1' },
  { id: 'beam', label: 'Beam', value: '1', min: '0.4', max: '3', fmt: 'x1' },
  { id: 'intensity', label: 'Glow', value: '1', min: '0.2', max: '2', fmt: 'x1' },
  { id: 'afterglow', label: 'Decay', value: '0.15', min: '0', max: '0.95', fmt: 'pct' }
];

const modeDetailKnobs: KnobDefinition[] = [
  { id: 'x-scale', label: 'Width', value: '1', min: '0.5', max: '2', fmt: 'x1' },
  { id: 'y-scale', label: 'Height', value: '1', min: '0.5', max: '2', fmt: 'x1' },
  { id: 'rotate', label: 'Angle', value: '0', min: '-180', max: '180', fmt: 'deg', bipolar: 'true' }
];
---

<div
  class={`visualizer-root ${isMini ? 'mini-mode' : 'fullscreen-mode'}`}
  data-mini={isMini ? 'true' : 'false'}
  data-color={color}
>
  <canvas id="visualizer-canvas"></canvas>

  {!isMini && (
    <div id="viz-ui">
      <div id="hud-bar">
        <div id="hud-left">
          <span id="hud-title">SS_SCOPE v4.1</span>
          <div id="hud-status">
            <div id="status-dot"></div>
            <span id="status-label">STANDBY</span>
          </div>
        </div>

        <div id="hud-center">
          <span id="hud-freq">FREQ: ---Hz</span>
          <span id="hud-rms">RMS: --.-dB</span>
          <span id="hud-mode-label">MODE: OSC</span>
          <span id="hud-perf">FPS: --/60 | --ms | DROP 0</span>
        </div>

        <div id="hud-right">
          <button id="panel-toggle-btn" title="Toggle panel">PANEL</button>
        </div>
      </div>

      <div id="perf-overlay"></div>

      <div id="engage-overlay">
        <button id="engage-overlay-btn" type="button">
          <span id="engage-overlay-title">ENGAGE</span>
          <span id="engage-overlay-status">MIC STANDBY</span>
        </button>
      </div>

      <div id="control-panel">
        <div id="panel-inner">
          <details class="panel-section primary-section" open>
            <summary>GLOBAL</summary>
            <div class="primary-grid">
              {sharedKnobs.map(knob => (
                <div class="knob-wrap">
                  <canvas
                    class="design-knob"
                    data-id={knob.id}
                    data-min={knob.min}
                    data-max={knob.max}
                    data-val={knob.value}
                    data-fmt={knob.fmt}
                    data-bipolar={knob.bipolar}
                  ></canvas>
                  <span class="knob-label">{knob.label}</span>
                  <span class="knob-value" data-for={knob.id}></span>
                </div>
              ))}
            </div>
          </details>

          <details class="panel-section" open>
            <summary>MODE</summary>
            <div class="mode-panel">
              <div class="btn-group mode-selector">
                {[
                  { id: 'scope', label: 'OSC' },
                  { id: 'spectrum', label: 'SPECTRUM' },
                  { id: 'lissajous', label: 'LISSAJOUS' },
                  { id: 'radial', label: 'RADIAL' },
                  { id: 'waterfall', label: 'WATERFALL' },
                  { id: 'particle', label: 'PARTICLE' }
                ].map(mode => (
                  <button class="mode-btn" data-mode={mode.id}>{mode.label}</button>
                ))}
              </div>

              <div class="mode-tools">
                <button id="pixelmap-btn" class="toggle-btn" data-active="false">PIXEL MAP</button>
                <button id="hud-toggle-btn" class="toggle-btn" data-active="true">HUD</button>
                <button id="scope-only-btn" class="toggle-btn" data-active="false">WAVE ONLY</button>
                <button id="reset-btn" class="toggle-btn">RESET</button>
              </div>

              <div class="utility-strip">
                <select id="input-select" class="viz-select">
                  <option value="">default mic</option>
                </select>
                <button id="start-btn">ENGAGE</button>
                <button id="stop-btn" class="hidden">STOP</button>
                <span id="init-hint">mic standby</span>
              </div>
            </div>
          </details>

          <details class="panel-section mode-detail-section" open>
            <summary>MODE DETAIL</summary>
            <div id="mode-detail-panel">
              <div class="mode-readout">
                <span id="mode-detail-title">OSC TRACE</span>
                <span id="mode-detail-scope">TIME DOMAIN</span>
              </div>

              <div class="mode-detail-grid">
                {modeDetailKnobs.map(knob => (
                  <div class="knob-wrap">
                    <canvas
                      class="design-knob"
                      data-id={knob.id}
                      data-min={knob.min}
                      data-max={knob.max}
                      data-val={knob.value}
                      data-fmt={knob.fmt}
                      data-bipolar={knob.bipolar}
                    ></canvas>
                    <span class="knob-label" data-label-for={knob.id}>{knob.label}</span>
                    <span class="knob-value" data-for={knob.id}></span>
                  </div>
                ))}
              </div>
            </div>
          </details>

          <details class="panel-section">
            <summary>COLOR</summary>
            <div class="color-grid">
              <label>Preset
                <select id="color-select" class="viz-select compact-select">
                  <option value="#36ff72" selected>VECTOR GREEN</option>
                  <option value="#ffb000">AMBER CRT</option>
                  <option value="#7fd8ff">ICE BLUE</option>
                  <option value="#ff4dff">LASER MAGENTA</option>
                  <option value="#ffff00">ACID YELLOW</option>
                  <option value="#f4f4f4">TERMINAL WHITE</option>
                </select>
              </label>

              <div class="knob-wrap compact-knob">
                <canvas class="design-knob" data-id="hue" data-min="0" data-max="360" data-val="136" data-fmt="deg"></canvas>
                <span class="knob-label">Hue</span>
                <span class="knob-value" data-for="hue"></span>
              </div>
            </div>
          </details>

          <details class="panel-section">
            <summary>ADVANCED</summary>
            <div id="advanced-grid">
              <label>FPS
                <select id="fps-select" class="viz-select compact-select">
                  {[15, 24, 30, 60, 120].map(v => <option value={v} selected={v === 30}>{v}</option>)}
                </select>
              </label>
              <label>QUALITY
                <select id="glow-select" class="viz-select compact-select">
                  <option value="off">OFF</option>
                  <option value="low" selected>LOW</option>
                  <option value="high">HIGH</option>
                </select>
              </label>
              <label>FFT
                <select id="fft-select" class="viz-select compact-select">
                  <option value="auto" selected>AUTO</option>
                  <option value="512">512</option>
                  <option value="1024">1024</option>
                  <option value="2048">2048</option>
                  <option value="4096">4096</option>
                </select>
              </label>
              <label>DENSITY
                <select id="sample-select" class="viz-select compact-select">
                  <option value="1">1:1</option>
                  <option value="2" selected>1:2</option>
                  <option value="4">1:4</option>
                  <option value="8">1:8</option>
                </select>
              </label>
              <label>RENDER
                <select id="render-scale-select" class="viz-select compact-select">
                  <option value="1">1.0</option>
                  <option value="0.75" selected>0.75</option>
                  <option value="0.5">0.5</option>
                </select>
              </label>
              <button id="adaptive-btn" class="toggle-btn" data-active="false">ADAPT</button>
              <button id="stats-btn" class="toggle-btn" data-active="false">STATS</button>
              <button id="ultra-btn" class="toggle-btn" data-active="false">ULTRA</button>
            </div>
          </details>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .visualizer-root {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100dvh;
    overflow: hidden;
    background: #000;
    color: #d8ff72;
    --accent: #36ff72;
  }

  .visualizer-root::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    background: repeating-linear-gradient(to bottom, rgba(255,255,255,0.018) 0px, rgba(255,255,255,0.018) 1px, transparent 2px, transparent 4px);
    mix-blend-mode: screen;
    opacity: 0.26;
  }

  .visualizer-root::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    background: radial-gradient(circle at center, transparent 45%, rgba(0,0,0,0.55) 100%);
  }

  .visualizer-root.scope-only::before,
  .visualizer-root.scope-only::after,
  .visualizer-root.scope-only #viz-ui {
    display: none;
  }

  canvas#visualizer-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  #viz-ui {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  #hud-bar {
    position: absolute;
    z-index: 24;
    top: 0;
    left: 0;
    right: 0;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: max(10px, env(safe-area-inset-top)) max(14px, env(safe-area-inset-right)) 8px max(14px, env(safe-area-inset-left));
    background: linear-gradient(to bottom, rgba(0,0,0,0.62), rgba(0,0,0,0));
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #hud-left,
  #hud-center,
  #hud-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #hud-title {
    color: rgba(255,255,255,0.7);
    font-size: 11px;
    font-weight: 700;
  }

  #hud-status {
    display: flex;
    align-items: center;
    gap: 7px;
    color: rgba(255,255,255,0.38);
    font-size: 10px;
  }

  #status-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #333;
    box-shadow: 0 0 0 transparent;
  }

  .is-running #status-dot {
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .is-running #status-label {
    color: var(--accent);
  }

  #hud-center {
    flex-wrap: wrap;
    justify-content: center;
    color: rgba(255,255,255,0.42);
    font-size: 10px;
  }

  #panel-toggle-btn,
  #start-btn,
  #stop-btn,
  .toggle-btn,
  .mode-btn {
    appearance: none;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(8,8,8,0.72);
    color: rgba(255,255,255,0.46);
    min-height: 34px;
    padding: 0 12px;
    font: inherit;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    pointer-events: auto;
    transition: border-color .18s ease, color .18s ease, background .18s ease, opacity .18s ease;
  }

  #panel-toggle-btn:hover,
  #start-btn:hover,
  #stop-btn:hover,
  .toggle-btn:hover,
  .mode-btn:hover,
  .mode-btn.active,
  .toggle-btn[data-active="true"] {
    border-color: color-mix(in srgb, var(--accent), transparent 55%);
    color: var(--accent);
    background: rgba(54,255,114,0.06);
  }

  #perf-overlay {
    position: absolute;
    right: max(14px, env(safe-area-inset-right));
    top: calc(max(10px, env(safe-area-inset-top)) + 58px);
    min-width: 180px;
    padding: 10px 12px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(0,0,0,0.6);
    color: rgba(255,255,255,0.48);
    font-size: 10px;
    line-height: 1.7;
    white-space: pre;
    opacity: 0;
    pointer-events: none;
  }

  #perf-overlay.active {
    opacity: 1;
  }

  #engage-overlay {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    padding: max(24px, env(safe-area-inset-top)) max(18px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(18px, env(safe-area-inset-left));
    background:
      radial-gradient(circle at center, rgba(54,255,114,0.12), transparent 34%),
      rgba(0,0,0,0.72);
    backdrop-filter: blur(8px);
    pointer-events: auto;
    transition: opacity .24s ease, visibility .24s ease;
  }

  #engage-overlay.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #engage-overlay-btn {
    appearance: none;
    width: min(420px, 88vw);
    min-height: 180px;
    border: 1px solid color-mix(in srgb, var(--accent), transparent 40%);
    background: rgba(0,0,0,0.76);
    color: var(--accent);
    display: grid;
    place-items: center;
    gap: 14px;
    padding: 28px;
    cursor: pointer;
    box-shadow:
      0 0 28px rgba(54,255,114,0.12),
      inset 0 0 26px rgba(54,255,114,0.08);
    font: inherit;
    text-transform: uppercase;
    transition: border-color .18s ease, color .18s ease, transform .18s ease, background .18s ease;
  }

  #engage-overlay-btn:hover {
    border-color: var(--accent);
    background: rgba(54,255,114,0.06);
    transform: translateY(-1px);
  }

  #engage-overlay-title {
    font-size: clamp(34px, 8vw, 74px);
    line-height: 0.9;
    letter-spacing: 0.22em;
    font-weight: 800;
  }

  #engage-overlay-status {
    color: rgba(255,255,255,0.48);
    font-size: 11px;
    letter-spacing: 0.24em;
  }

  #control-panel {
    position: absolute;
    z-index: 32;
    right: max(14px, env(safe-area-inset-right));
    bottom: max(14px, env(safe-area-inset-bottom));
    width: min(520px, calc(100vw - 28px));
    max-height: calc(100dvh - env(safe-area-inset-top) - 28px);
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(5,5,5,0.74);
    backdrop-filter: blur(18px);
    box-shadow: 0 0 40px rgba(0,0,0,0.7);
    pointer-events: auto;
    transition: opacity .18s ease, transform .18s ease;
  }

  #control-panel.hidden {
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
  }

  #panel-inner {
    max-height: inherit;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    padding: 22px 18px calc(18px + env(safe-area-inset-bottom));
  }

  #panel-inner::-webkit-scrollbar {
    width: 6px;
  }

  #panel-inner::-webkit-scrollbar-thumb {
    background: #252525;
    border-radius: 999px;
  }

  .panel-section {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 12px 0;
  }

  .panel-section:first-child {
    border-top: none;
    padding-top: 0;
  }

  .panel-section summary {
    cursor: pointer;
    list-style: none;
    color: rgba(255,255,255,0.58);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .panel-section summary::-webkit-details-marker {
    display: none;
  }

  .primary-grid,
  .mode-detail-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px 12px;
  }

  #mode-detail-panel {
    display: grid;
    gap: 14px;
  }

  .mode-readout {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    min-height: 30px;
    padding: 0 0 8px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.46);
    text-transform: uppercase;
  }

  #mode-detail-title {
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.18em;
    font-weight: 700;
  }

  #mode-detail-scope {
    color: rgba(255,255,255,0.34);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-align: right;
  }

  .knob-wrap {
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: 5px;
    color: rgba(255,255,255,0.44);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .design-knob {
    width: 58px;
    height: 58px;
    cursor: ns-resize;
    touch-action: none;
  }

  .knob-value {
    color: var(--accent);
    font-size: 10px;
  }

  .mode-panel,
  .color-grid,
  #advanced-grid {
    display: grid;
    gap: 12px;
  }

  .btn-group,
  .mode-tools,
  .utility-strip,
  #advanced-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .utility-strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
  }

  .viz-select {
    min-height: 34px;
    min-width: 0;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(0,0,0,0.72);
    color: rgba(255,255,255,0.62);
    font: inherit;
    font-size: 10px;
    letter-spacing: 0.1em;
    padding: 0 10px;
  }

  .color-grid {
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .color-grid label,
  #advanced-grid label {
    display: grid;
    gap: 5px;
    color: rgba(255,255,255,0.42);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .compact-select {
    width: 130px;
  }

  #init-hint {
    color: rgba(255,255,255,0.32);
    font-size: 10px;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .hidden {
    display: none !important;
  }

  .hud-hidden #hud-bar {
    display: none;
  }

  @media (max-width: 900px) {
    #control-panel {
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: min(74dvh, 640px);
      border-left: none;
      border-right: none;
      border-bottom: none;
    }

    .primary-grid,
    .mode-detail-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    #hud-bar {
      display: none;
    }

    #control-panel {
      max-height: 76dvh;
    }

    #panel-inner {
      padding: 16px 14px calc(18px + env(safe-area-inset-bottom));
    }

    .primary-grid,
    .mode-detail-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px 8px;
    }

    .mode-readout {
      align-items: flex-start;
      flex-direction: column;
    }

    .utility-strip {
      grid-template-columns: 1fr;
    }

    #start-btn,
    #stop-btn,
    .toggle-btn,
    .mode-btn,
    .viz-select {
      min-height: 42px;
    }

    .color-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-height: 520px) and (orientation: landscape) {
    #control-panel {
      max-height: 64dvh;
    }

    .primary-grid,
    .mode-detail-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .design-knob {
      width: 48px;
      height: 48px;
    }
  }
</style>

<script>
  import { AudioEngine } from '../lib/audio/AudioEngine';

  type VizMode =
    | 'scope'
    | 'spectrum'
    | 'lissajous'
    | 'radial'
    | 'waterfall'
    | 'particle'
    | 'pixel_map';

  type GlowQuality =
    | 'off'
    | 'low'
    | 'high';

  interface KnobState {
    min: number;
    max: number;
    val: number;
    fmt: string;
    log: boolean;
    bipolar: boolean;
  }

  interface RenderParams {
    targetFps: number;
    motionSpeed: number;
    sampleStep: number;
    renderScale: number;
    beam: number;
    intensity: number;
    afterglow: number;
    xScale: number;
    yScale: number;
    rotation: number;
    pixelMap: boolean;
    glowQuality: GlowQuality;
    width: number;
    height: number;
    dpr: number;
  }

  const ROOT =
    document.querySelector('.visualizer-root') as HTMLElement;

  const canvas =
    ROOT.querySelector('#visualizer-canvas') as HTMLCanvasElement;

  const IS_MINI =
    ROOT.dataset.mini === 'true';

  let ACCENT =
    ROOT.dataset.color ?? '#36ff72';

  ROOT.style.setProperty(
    '--accent',
    ACCENT
  );

  let engine: AudioEngine | null = null;
  let worker: Worker | null = null;
  let workerReady = false;
  let offscreenMode = false;
  let running = false;
  let startingAudio = false;
  let animationId = 0;
  let lastFrameAt = 0;
  let fpsWindowAt = 0;
  let fpsFrames = 0;
  let actualFps = 0;
  let droppedFrames = 0;
  let msFrame = 0;
  let targetFps = 30;
  let motionSpeed = 1;
  let sampleStep = IS_MINI ? 4 : 2;
  let renderScale = IS_MINI ? 1 : 0.75;
  let mode: VizMode = 'scope';
  let pixelMap = false;
  let hudVisible = true;
  let scopeOnly = false;
  let adaptiveQuality = false;
  let statsVisible = false;
  let ultraMinimal = false;
  let glowQuality: GlowQuality = IS_MINI ? 'off' : 'low';
  let fftSetting: 'auto' | '512' | '1024' | '2048' | '4096' = 'auto';
  let timeData = new Uint8Array(2048);
  let freqData = new Uint8Array(2048);
  let lissajousXData = new Uint8Array(2048);
  let lissajousYData = new Uint8Array(2048);
  let sharedTime: Uint8Array | null = null;
  let sharedFreq: Uint8Array | null = null;
  let sharedBuffer: SharedArrayBuffer | null = null;
  let fallbackCtx: CanvasRenderingContext2D | null = null;
  let demoT = 0;

  const params: RenderParams = {
    targetFps,
    motionSpeed,
    sampleStep,
    renderScale,
    beam: 1,
    intensity: 1,
    afterglow: IS_MINI ? 0 : 0.15,
    xScale: 1,
    yScale: 1,
    rotation: 0,
    pixelMap,
    glowQuality,
    width: 1,
    height: 1,
    dpr: 1
  };

  class KnobEngine {
    private knobs = new Map<string, KnobState>();
    private canvases = new Map<string, HTMLCanvasElement>();

    constructor(
      private container: ParentNode,
      private onChange: (id: string, value: number) => void
    ) {
      this.init();
    }

    reset(defaults: Record<string, number>) {
      Object.entries(defaults).forEach(([id, value]) => {
        this.set(id, value);
      });
    }

    set(id: string, value: number) {
      const state =
        this.knobs.get(id);

      const canvas =
        this.canvases.get(id);

      if (!state || !canvas) {
        return;
      }

      state.val =
        Math.max(
          state.min,
          Math.min(
            state.max,
            value
          )
        );

      canvas.dataset.val =
        String(state.val);

      this.draw(canvas, state);
      this.updateLabel(id, state);
      this.onChange(id, state.val);
    }

    redraw() {
      this.canvases.forEach((canvas, id) => {
        const state =
          this.knobs.get(id);

        if (state) {
          this.draw(canvas, state);
        }
      });
    }

    private init() {
      this.container
        .querySelectorAll('canvas[data-id][data-min][data-max]')
        .forEach((element) => {
          const canvas =
            element as HTMLCanvasElement;

          const id =
            canvas.dataset.id;

          if (!id) {
            return;
          }

          const state: KnobState = {
            min: Number(canvas.dataset.min ?? 0),
            max: Number(canvas.dataset.max ?? 1),
            val: Number(canvas.dataset.val ?? 0),
            fmt: canvas.dataset.fmt ?? 'raw',
            log: canvas.dataset.log === 'true',
            bipolar: canvas.dataset.bipolar === 'true'
          };

          this.knobs.set(id, state);
          this.canvases.set(id, canvas);
          this.draw(canvas, state);
          this.updateLabel(id, state);
          this.bind(canvas, id, state);
          this.onChange(id, state.val);
        });
    }

    private bind(
      canvas: HTMLCanvasElement,
      id: string,
      state: KnobState
    ) {
      let startY = 0;
      let startValue = 0;
      let dragging = false;

      const move = (
        clientY: number,
        fine = false
      ) => {
        const dy =
          startY - clientY;

        const range =
          state.max - state.min;

        const speed =
          fine ? 0.001 : 0.004;

        let next: number;

        if (
          state.log &&
          state.min > 0
        ) {
          next =
            startValue *
            Math.exp(
              dy *
              speed *
              Math.log(state.max / state.min)
            );
        } else {
          next =
            startValue +
            dy *
            range *
            speed;
        }

        state.val =
          Math.max(
            state.min,
            Math.min(
              state.max,
              next
            )
          );

        canvas.dataset.val =
          String(state.val);

        this.draw(canvas, state);
        this.updateLabel(id, state);
        this.onChange(id, state.val);
      };

      canvas.addEventListener(
        'pointerdown',
        (event) => {
          dragging = true;
          startY = event.clientY;
          startValue = state.val;
          canvas.setPointerCapture(event.pointerId);
          event.preventDefault();
        }
      );

      canvas.addEventListener(
        'pointermove',
        (event) => {
          if (dragging) {
            move(
              event.clientY,
              event.shiftKey
            );
          }
        }
      );

      canvas.addEventListener(
        'pointerup',
        () => {
          dragging = false;
        }
      );

      canvas.addEventListener(
        'wheel',
        (event) => {
          event.preventDefault();

          const delta =
            -Math.sign(event.deltaY) *
            (state.max - state.min) *
            (event.shiftKey ? 0.004 : 0.025);

          this.set(
            id,
            state.val + delta
          );
        },
        { passive: false }
      );

      canvas.addEventListener(
        'dblclick',
        () => {
          this.set(
            id,
            Number(canvas.dataset.val ?? state.val)
          );
        }
      );
    }

    private format(
      value: number,
      fmt: string
    ) {
      switch (fmt) {
        case 'pct':
          return `${Math.round(value * 100)}%`;
        case 'x1':
          return `${value.toFixed(1)}x`;
        case 'x2':
          return `${value.toFixed(2)}x`;
        case 'deg':
          return `${Math.round(value)}deg`;
        case 'hz':
          return value >= 1000
            ? `${(value / 1000).toFixed(1)}kHz`
            : `${Math.round(value)}Hz`;
        default:
          return `${Math.round(value)}`;
      }
    }

    private updateLabel(
      id: string,
      state: KnobState
    ) {
      const label =
        this.container
          .querySelector(`[data-for="${id}"]`);

      if (label) {
        label.textContent =
          this.format(
            state.val,
            state.fmt
          );
      }
    }

    private draw(
      canvas: HTMLCanvasElement,
      state: KnobState
    ) {
      const size =
        Math.max(
          44,
          Math.round(canvas.getBoundingClientRect().width || 58)
        );

      const dpr =
        Math.min(
          window.devicePixelRatio || 1,
          2
        );

      canvas.width =
        size * dpr;

      canvas.height =
        size * dpr;

      const context =
        canvas.getContext('2d');

      if (!context) {
        return;
      }

      context.setTransform(dpr, 0, 0, dpr, 0, 0);
      context.clearRect(0, 0, size, size);

      const cx = size / 2;
      const cy = size / 2;
      const radius = size / 2 - 6;
      const start = Math.PI * 0.75;
      const sweep = Math.PI * 1.5;

      const norm =
        state.log && state.min > 0
          ? Math.log(state.val / state.min) / Math.log(state.max / state.min)
          : (state.val - state.min) / (state.max - state.min);

      const clamped =
        Math.max(
          0,
          Math.min(
            1,
            norm
          )
        );

      const angle =
        start + clamped * sweep;

      context.beginPath();
      context.arc(cx, cy, radius, start, start + sweep);
      context.strokeStyle = '#1d1d1d';
      context.lineWidth = 4;
      context.lineCap = 'round';
      context.stroke();

      const fillStart =
        state.bipolar
          ? start + sweep * 0.5
          : start;

      context.beginPath();

      if (
        state.bipolar &&
        clamped < 0.5
      ) {
        context.arc(cx, cy, radius, angle, fillStart);
      } else {
        context.arc(cx, cy, radius, fillStart, angle);
      }

      context.strokeStyle = ACCENT;
      context.shadowBlur = 8;
      context.shadowColor = ACCENT;
      context.stroke();
      context.shadowBlur = 0;

      context.beginPath();
      context.arc(
        cx + Math.cos(angle) * radius,
        cy + Math.sin(angle) * radius,
        2.8,
        0,
        Math.PI * 2
      );
      context.fillStyle = '#fff';
      context.shadowBlur = 6;
      context.shadowColor = '#fff';
      context.fill();

      context.shadowBlur = 0;
      context.beginPath();
      context.arc(cx, cy, radius * 0.32, 0, Math.PI * 2);
      context.strokeStyle = '#252525';
      context.lineWidth = 1;
      context.stroke();
    }
  }

  const dpr = () =>
    Math.min(
      window.devicePixelRatio || 1,
      2
    ) * renderScale;

  const setTargetFps = (value: number) => {
    targetFps =
      value;

    params.targetFps =
      targetFps;
  };

  const normalizeAccent = (value: string) => {
    const scratch =
      document.createElement('span');

    scratch.style.color =
      value;

    document.body.appendChild(scratch);

    const computed =
      getComputedStyle(scratch).color;

    scratch.remove();

    const match =
      computed.match(/\d+(\.\d+)?/g);

    if (!match || match.length < 3) {
      return '#36ff72';
    }

    return `#${match
      .slice(0, 3)
      .map(part => Number(part)
        .toString(16)
        .padStart(2, '0'))
      .join('')}`;
  };

  const resize = () => {
    const scale =
      dpr();

    const width =
      Math.max(
        1,
        Math.floor(canvas.clientWidth * scale)
      );

    const height =
      Math.max(
        1,
        Math.floor(canvas.clientHeight * scale)
      );

    params.width =
      width;

    params.height =
      height;

    params.dpr =
      scale;

    if (offscreenMode) {
      worker?.postMessage({
        type: 'resize',
        width,
        height,
        dpr: scale
      });
    } else {
      canvas.width =
        width;

      canvas.height =
        height;
    }
  };

  const applyFft = () => {
    const value =
      fftSetting === 'auto'
        ? (
          mode === 'spectrum' ||
          mode === 'waterfall'
            ? 4096
            : 1024
        )
        : Number(fftSetting);

    timeData =
      new Uint8Array(value);

    freqData =
      new Uint8Array(value);

    lissajousXData =
      new Uint8Array(value);

    lissajousYData =
      new Uint8Array(value);

    if (engine) {
      engine.setFftSize(
        value,
        value * 2
      );
    }
  };

  const initWorker = () => {
    if (
      !('transferControlToOffscreen' in canvas) ||
      IS_MINI
    ) {
      fallbackCtx =
        canvas.getContext('2d');

      return;
    }

    try {
      const offscreen =
        canvas.transferControlToOffscreen();

      worker =
        new Worker(
          new URL('../scripts/visualizer-worker.ts', import.meta.url),
          { type: 'module' }
        );

      const timeLength =
        timeData.length;

      const freqLength =
        freqData.length;

      if (
        window.crossOriginIsolated &&
        typeof SharedArrayBuffer !== 'undefined'
      ) {
        sharedBuffer =
          new SharedArrayBuffer(
            timeLength + freqLength
          );

        sharedTime =
          new Uint8Array(
            sharedBuffer,
            0,
            timeLength
          );

        sharedFreq =
          new Uint8Array(
            sharedBuffer,
            timeLength,
            freqLength
          );
      }

      worker.postMessage(
        {
          type: 'init',
          canvas: offscreen,
          color: normalizeAccent(ACCENT),
          sab: sharedBuffer ?? undefined,
          timeLength,
          freqLength
        },
        [offscreen]
      );

      worker.addEventListener(
        'message',
        (event: MessageEvent<{ type?: string }>) => {
          if (event.data?.type === 'ready') {
            workerReady =
              true;
          }
        }
      );

      worker.addEventListener(
        'error',
        () => {
          workerReady =
            false;
        }
      );

      worker.addEventListener(
        'messageerror',
        () => {
          workerReady =
            false;
        }
      );

      offscreenMode =
        true;

      workerReady =
        false;
    } catch (_error) {
      fallbackCtx =
        canvas.getContext('2d');
      offscreenMode =
        false;
    }
  };

  const populateDevices = async () => {
    const select =
      ROOT.querySelector('#input-select') as HTMLSelectElement | null;

    if (!select || !navigator.mediaDevices) {
      return;
    }

    try {
      const devices =
        engine
          ? await engine.getInputDevices()
          : await navigator.mediaDevices.enumerateDevices();

      select.innerHTML =
        '<option value="">default mic</option>';

      devices
        .filter(device => device.kind === 'audioinput')
        .forEach((device, index) => {
          const option =
            document.createElement('option');

          option.value =
            device.deviceId;

          option.textContent =
            device.label || `input ${index + 1}`;

          select.appendChild(option);
        });
    } catch (_error) {
      select.innerHTML =
        '<option value="">mic unavailable</option>';
    }
  };

  const setEngageOverlay = (
    state: 'standby' | 'starting' | 'blocked' | 'hidden'
  ) => {
    const overlay =
      ROOT.querySelector('#engage-overlay') as HTMLElement | null;

    const title =
      ROOT.querySelector('#engage-overlay-title') as HTMLElement | null;

    const status =
      ROOT.querySelector('#engage-overlay-status') as HTMLElement | null;

    if (!overlay) {
      return;
    }

    overlay.classList.toggle(
      'hidden',
      state === 'hidden'
    );

    if (title) {
      title.textContent =
        state === 'starting'
          ? 'STARTING'
          : state === 'blocked'
            ? 'RETRY'
            : 'ENGAGE';
    }

    if (status) {
      status.textContent =
        state === 'starting'
          ? 'REQUESTING MIC'
          : state === 'blocked'
            ? 'MIC BLOCKED'
            : 'MIC STANDBY';
    }
  };

  const startAudio = async () => {
    if (startingAudio) {
      return false;
    }

    startingAudio =
      true;

    const select =
      ROOT.querySelector('#input-select') as HTMLSelectElement | null;

    const status =
      ROOT.querySelector('#status-label');

    const hint =
      ROOT.querySelector('#init-hint');

    try {
      if (!engine) {
        engine =
          new AudioEngine();
      }

      if (hint) {
        hint.textContent =
          'requesting mic';
      }

      setEngageOverlay('starting');

      await engine.initInput(
        select?.value || undefined
      );

      engine.setMonitorLevel(
        params.beam >= 0
          ? currentVolume
          : 0
      );
    } catch (_error) {
      running =
        false;

      ROOT.classList.remove('is-running');
      ROOT.querySelector('#start-btn')?.classList.remove('hidden');
      ROOT.querySelector('#stop-btn')?.classList.add('hidden');

      if (status) {
        status.textContent =
          'MIC BLOCKED';
      }

      if (hint) {
        hint.textContent =
          'mic unavailable';
      }

      setEngageOverlay('blocked');
      startingAudio =
        false;

      return false;
    }

    running =
      true;

    ROOT.classList.add('is-running');

    if (status) {
      status.textContent =
        'ONLINE';
    }

    ROOT.querySelector('#start-btn')?.classList.add('hidden');
    ROOT.querySelector('#stop-btn')?.classList.remove('hidden');

    if (hint) {
      hint.textContent =
        'analysis active';
    }

    setEngageOverlay('hidden');

    await populateDevices();

    startingAudio =
      false;

    return true;
  };

  const stopAudio = async () => {
    running =
      false;

    if (engine) {
      engine.stopInput();
      engine.muteMonitor();
    }

    ROOT.classList.remove('is-running');
    ROOT.querySelector('#start-btn')?.classList.remove('hidden');
    ROOT.querySelector('#stop-btn')?.classList.add('hidden');
    ROOT.querySelector('#init-hint')!.textContent = 'mic standby';
    setEngageOverlay('standby');

    const status =
      ROOT.querySelector('#status-label');

    if (status) {
      status.textContent =
        'STANDBY';
    }
  };

  let currentVolume = 0;

  const setAccent = (value: string) => {
    ACCENT =
      value;

    ROOT.dataset.color =
      value;

    ROOT.style.setProperty(
      '--accent',
      value
    );

    worker?.postMessage({
      type: 'color',
      value: normalizeAccent(value)
    });
  };

  const setScopeOnly = (active: boolean) => {
    scopeOnly =
      active;

    ROOT.classList.toggle(
      'scope-only',
      active
    );

    document.dispatchEvent(
      new CustomEvent(
        'ss-scope-only',
        {
          detail: {
            active
          }
        }
      )
    );

    const button =
      ROOT.querySelector('#scope-only-btn') as HTMLElement | null;

    if (button) {
      button.dataset.active =
        String(active);
    }
  };

  const applyKnob = (
    id: string,
    value: number
  ) => {
    switch (id) {
      case 'volume':
        currentVolume =
          value;

        engine?.setMonitorLevel(
          value
        );
        break;
      case 'speed':
        motionSpeed =
          value;

        params.motionSpeed =
          motionSpeed;
        break;
      case 'scale':
        params.xScale =
          value;

        params.yScale =
          value;
        break;
      case 'beam':
        params.beam =
          value;
        break;
      case 'intensity':
        params.intensity =
          value;
        break;
      case 'afterglow':
        params.afterglow =
          ultraMinimal
            ? 0
            : value;
        break;
      case 'x-scale':
        params.xScale =
          value;
        break;
      case 'y-scale':
        params.yScale =
          value;
        break;
      case 'rotate':
        params.rotation =
          value;
        break;
      case 'hue':
        setAccent(
          `hsl(${Math.round(value)} 100% 61%)`
        );
        break;
      default:
        break;
    }
  };

  const knobEngine =
    !IS_MINI
      ? new KnobEngine(
        ROOT,
        applyKnob
      )
      : null;

  const collectAudioFrame = () => {
    if (engine && running) {
      const timeTarget =
        sharedTime ?? timeData;

      engine.fillTimeData(
        timeTarget
      );

      if (
        mode === 'spectrum' ||
        mode === 'waterfall' ||
        mode === 'particle'
      ) {
        const freqTarget =
          sharedFreq ?? freqData;

        engine.fillFrequencyData(
          freqTarget
        );
      }

      if (mode === 'lissajous') {
        engine.fillLissajousData(
          lissajousXData,
          lissajousYData
        );
      }
    }
  };

  const postFrame = () => {
    const needsFrequencyData =
      mode === 'spectrum' ||
      mode === 'waterfall' ||
      mode === 'particle';

    params.sampleStep =
      sampleStep;

    params.renderScale =
      renderScale;

    params.pixelMap =
      pixelMap;

    params.glowQuality =
      glowQuality;

    params.targetFps =
      targetFps;

    params.motionSpeed =
      motionSpeed;

    if (
      workerReady &&
      worker
    ) {
      worker.postMessage({
        type: 'frame',
        timeData: sharedTime ? undefined : timeData,
        freqData: needsFrequencyData && !sharedFreq
          ? freqData
          : undefined,
        lissajousXData: mode === 'lissajous'
          ? lissajousXData
          : undefined,
        lissajousYData: mode === 'lissajous'
          ? lissajousYData
          : undefined,
        mode,
        params,
        running
      });
    } else {
      drawFallback();
    }
  };

  const updateHud = () => {
    if (IS_MINI) {
      return;
    }

    const perf =
      ROOT.querySelector('#hud-perf');

    if (perf) {
      perf.textContent =
        `FPS: ${actualFps.toFixed(0)}/${targetFps} | ${msFrame.toFixed(1)}ms | DROP ${droppedFrames}`;
    }

    const modeLabel =
      ROOT.querySelector('#hud-mode-label');

    if (modeLabel) {
      modeLabel.textContent =
        `MODE: ${mode.toUpperCase()}`;
    }

    const overlay =
      ROOT.querySelector('#perf-overlay') as HTMLElement | null;

    if (overlay) {
      overlay.classList.toggle(
        'active',
        statsVisible && !scopeOnly
      );

      overlay.textContent =
        `actual fps  ${actualFps.toFixed(1)}
target fps  ${targetFps}
ms/frame    ${msFrame.toFixed(1)}
dropped     ${droppedFrames}
render      ${renderScale}
fft         ${timeData.length}
sample      1:${sampleStep}
glow        ${glowQuality}`;
    }

    if (
      engine &&
      running
    ) {
      const freq =
        ROOT.querySelector('#hud-freq');

      const rms =
        ROOT.querySelector('#hud-rms');

      if (freq) {
        freq.textContent =
          `FREQ: ${engine.getPeakFrequency().toFixed(0)}Hz`;
      }

      if (rms) {
        rms.textContent =
          `RMS: ${engine.getRMSdB().toFixed(1)}dB`;
      }
    }
  };

  const applyAdaptiveQuality = () => {
    if (
      !adaptiveQuality ||
      actualFps <= 0
    ) {
      return;
    }

    if (actualFps < targetFps * 0.72) {
      sampleStep =
        Math.min(
          8,
          sampleStep * 2
        );

      glowQuality =
        glowQuality === 'high'
          ? 'low'
          : 'off';

      renderScale =
        Math.max(
          0.5,
          renderScale * 0.75
        );

      resize();
    }
  };

  const drawFallback = () => {
    if (!fallbackCtx) {
      return;
    }

    const context =
      fallbackCtx;

    const width =
      canvas.width;

    const height =
      canvas.height;

    demoT +=
      0.026 * params.motionSpeed;

    context.fillStyle =
      `rgba(0,0,0,${Math.max(0.05, 1 - params.afterglow)})`;

    context.fillRect(0, 0, width, height);
    context.save();
    context.scale(params.dpr, params.dpr);
    context.strokeStyle =
      ACCENT;

    context.shadowBlur =
      glowQuality === 'off'
        ? 0
        : 10 * params.intensity;

    context.shadowColor =
      ACCENT;

    context.lineWidth =
      1.2 * params.beam;

    const logicalW =
      width / params.dpr;

    const logicalH =
      height / params.dpr;

    context.beginPath();

    if (mode === 'lissajous') {
      const length =
        running
          ? Math.min(
            lissajousXData.length,
            lissajousYData.length
          )
          : 768;

      for (let i = 0; i < length; i += sampleStep) {
        const phase =
          i / Math.max(
            1,
            length - 1
          );

        const xValue =
          running
            ? ((lissajousXData[i] ?? 128) - 128) / 128
            : Math.sin(phase * Math.PI * 2 + demoT);

        const yValue =
          running
            ? ((lissajousYData[i] ?? 128) - 128) / 128
            : Math.sin(phase * Math.PI * 2 + demoT + Math.PI / 2);

        const x =
          logicalW / 2 +
          xValue *
          logicalW *
          0.38 *
          params.xScale;

        const y =
          logicalH / 2 +
          yValue *
          logicalH *
          0.38 *
          params.yScale;

        if (i === 0) {
          context.moveTo(x, y);
        } else {
          context.lineTo(x, y);
        }
      }
    } else {
      for (let i = 0; i < timeData.length; i += sampleStep) {
        const signal =
          running
            ? timeData[i]
            : 128 + Math.sin(i * 0.025 + demoT) * 42 + Math.sin(i * 0.071 - demoT) * 12;

        const x =
          (i / (timeData.length - 1)) * logicalW;

        const y =
          logicalH / 2 +
          ((signal / 128) - 1) *
          logicalH *
          0.42 *
          params.yScale;

        if (i === 0) {
          context.moveTo(x, y);
        } else {
          context.lineTo(x, y);
        }
      }
    }

    context.stroke();
    context.restore();
  };

  const frameLoop = (now = 0) => {
    animationId =
      requestAnimationFrame(frameLoop);

    if (document.hidden) {
      return;
    }

    if (!lastFrameAt) {
      lastFrameAt =
        now;
    }

    const interval =
      1000 / targetFps;

    const elapsed =
      now - lastFrameAt;

    if (elapsed < interval * 0.92) {
      return;
    }

    msFrame =
      elapsed;

    if (elapsed > interval * 1.7) {
      droppedFrames++;
    }

    lastFrameAt =
      now - (elapsed % interval);

    fpsFrames++;

    if (!fpsWindowAt) {
      fpsWindowAt =
        now;
    }

    if (now - fpsWindowAt >= 500) {
      actualFps =
        fpsFrames * 1000 / (now - fpsWindowAt);

      fpsFrames =
        0;

      fpsWindowAt =
        now;

      applyAdaptiveQuality();
      updateHud();
    }

    collectAudioFrame();
    postFrame();
  };

  const modeDetails: Record<
    VizMode,
    {
      title: string;
      scope: string;
      labels: Record<'x-scale' | 'y-scale' | 'rotate', string>;
    }
  > = {
    scope: {
      title: 'OSC TRACE',
      scope: 'TIME DOMAIN',
      labels: {
        'x-scale': 'Horizontal',
        'y-scale': 'Amplitude',
        rotate: 'Trace Tilt'
      }
    },
    spectrum: {
      title: 'SPECTRUM',
      scope: 'FREQUENCY',
      labels: {
        'x-scale': 'Bar Width',
        'y-scale': 'Range',
        rotate: 'Tilt'
      }
    },
    lissajous: {
      title: 'LISSAJOUS',
      scope: 'STEREO FIELD',
      labels: {
        'x-scale': 'X Gain',
        'y-scale': 'Y Gain',
        rotate: 'Phase Tilt'
      }
    },
    radial: {
      title: 'RADIAL',
      scope: 'POLAR TRACE',
      labels: {
        'x-scale': 'Radius',
        'y-scale': 'Pulse',
        rotate: 'Spin'
      }
    },
    waterfall: {
      title: 'WATERFALL',
      scope: 'SPECTRAL TIME',
      labels: {
        'x-scale': 'Time Width',
        'y-scale': 'Frequency',
        rotate: 'Drift'
      }
    },
    particle: {
      title: 'PARTICLE',
      scope: 'ENERGY FIELD',
      labels: {
        'x-scale': 'Spread',
        'y-scale': 'Lift',
        rotate: 'Current'
      }
    },
    pixel_map: {
      title: 'PIXEL MAP',
      scope: 'GRID ENERGY',
      labels: {
        'x-scale': 'Columns',
        'y-scale': 'Rows',
        rotate: 'Tilt'
      }
    }
  };

  const updateModeDetail = (next: VizMode) => {
    const detail =
      modeDetails[next];

    const panel =
      ROOT.querySelector('#mode-detail-panel') as HTMLElement | null;

    const title =
      ROOT.querySelector('#mode-detail-title');

    const scope =
      ROOT.querySelector('#mode-detail-scope');

    if (panel) {
      panel.dataset.activeMode =
        next;
    }

    if (title) {
      title.textContent =
        detail.title;
    }

    if (scope) {
      scope.textContent =
        detail.scope;
    }

    Object
      .entries(detail.labels)
      .forEach(([id, label]) => {
        const target =
          ROOT.querySelector(`[data-label-for="${id}"]`);

        if (target) {
          target.textContent =
            label;
        }
      });
  };

  const setMode = (next: VizMode) => {
    mode =
      next;

    ROOT
      .querySelectorAll('.mode-btn')
      .forEach(button => {
        button.classList.toggle(
          'active',
          (button as HTMLElement).dataset.mode === next
        );
      });

    applyFft();
    updateModeDetail(next);
    updateHud();
  };

  const resetParams = () => {
    knobEngine?.reset({
      volume: 0,
      speed: 1,
      scale: 1,
      beam: 1,
      intensity: 1,
      afterglow: 0.15,
      'x-scale': 1,
      'y-scale': 1,
      rotate: 0,
      hue: 136
    });

    pixelMap =
      false;

    setScopeOnly(false);
    setMode('scope');
  };

  if (!IS_MINI) {
    populateDevices();

    ROOT.querySelector('#panel-toggle-btn')
      ?.addEventListener(
        'click',
        () => {
          ROOT.querySelector('#control-panel')
            ?.classList.toggle('hidden');
        }
      );

    document.addEventListener(
      'ss-toggle-panel',
      () => {
        ROOT.querySelector('#control-panel')
          ?.classList.toggle('hidden');
      }
    );

    ROOT.querySelector('#start-btn')
      ?.addEventListener(
        'click',
        () => {
          void startAudio();
        }
      );

    ROOT.querySelector('#engage-overlay-btn')
      ?.addEventListener(
        'click',
        () => {
          void startAudio();
        }
      );

    ROOT.querySelector('#stop-btn')
      ?.addEventListener(
        'click',
        () => {
          void stopAudio();
        }
      );

    ROOT.querySelector('#input-select')
      ?.addEventListener(
        'change',
        () => {
          if (running) {
            void startAudio();
          }
        }
      );

    ROOT.querySelectorAll('.mode-btn')
      .forEach(button => {
        button.addEventListener(
          'click',
          () => {
            const next =
              (button as HTMLElement).dataset.mode as VizMode;

            setMode(next);
          }
        );
      });

    ROOT.querySelector('#pixelmap-btn')
      ?.addEventListener(
        'click',
        (event) => {
          pixelMap =
            !pixelMap;

          (event.currentTarget as HTMLElement).dataset.active =
            String(pixelMap);
        }
      );

    ROOT.querySelector('#hud-toggle-btn')
      ?.addEventListener(
        'click',
        (event) => {
          hudVisible =
            !hudVisible;

          ROOT.classList.toggle(
            'hud-hidden',
            !hudVisible
          );

          (event.currentTarget as HTMLElement).dataset.active =
            String(hudVisible);
        }
      );

    ROOT.querySelector('#scope-only-btn')
      ?.addEventListener(
        'click',
        () => {
          setScopeOnly(!scopeOnly);
        }
      );

    ROOT.querySelector('#reset-btn')
      ?.addEventListener(
        'click',
        resetParams
      );

    ROOT.querySelector('#fps-select')
      ?.addEventListener(
        'change',
        (event) => {
          setTargetFps(
            Number((event.target as HTMLSelectElement).value)
          );
        }
      );

    ROOT.querySelector('#sample-select')
      ?.addEventListener(
        'change',
        (event) => {
          sampleStep =
            Number((event.target as HTMLSelectElement).value);
        }
      );

    ROOT.querySelector('#render-scale-select')
      ?.addEventListener(
        'change',
        (event) => {
          renderScale =
            Number((event.target as HTMLSelectElement).value);

          resize();
        }
      );

    ROOT.querySelector('#fft-select')
      ?.addEventListener(
        'change',
        (event) => {
          fftSetting =
            (event.target as HTMLSelectElement).value as typeof fftSetting;

          applyFft();
        }
      );

    ROOT.querySelector('#glow-select')
      ?.addEventListener(
        'change',
        (event) => {
          glowQuality =
            (event.target as HTMLSelectElement).value as GlowQuality;
        }
      );

    ROOT.querySelector('#color-select')
      ?.addEventListener(
        'change',
        (event) => {
          setAccent(
            (event.target as HTMLSelectElement).value
          );

          knobEngine?.redraw();
        }
      );

    ROOT.querySelector('#adaptive-btn')
      ?.addEventListener(
        'click',
        (event) => {
          adaptiveQuality =
            !adaptiveQuality;

          (event.currentTarget as HTMLElement).dataset.active =
            String(adaptiveQuality);
        }
      );

    ROOT.querySelector('#stats-btn')
      ?.addEventListener(
        'click',
        (event) => {
          statsVisible =
            !statsVisible;

          (event.currentTarget as HTMLElement).dataset.active =
            String(statsVisible);

          updateHud();
        }
      );

    ROOT.querySelector('#ultra-btn')
      ?.addEventListener(
        'click',
        (event) => {
          ultraMinimal =
            !ultraMinimal;

          (event.currentTarget as HTMLElement).dataset.active =
            String(ultraMinimal);

          if (ultraMinimal) {
            setTargetFps(120);
            sampleStep = Math.max(sampleStep, 4);
            glowQuality = 'off';
            params.afterglow = 0;
            pixelMap = false;
            setScopeOnly(true);
            setMode('scope');
          }
        }
      );

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Tab') {
          event.preventDefault();
          setScopeOnly(!scopeOnly);
        }

        if (
          event.key === 'Escape' &&
          scopeOnly
        ) {
          setScopeOnly(false);
        }
      }
    );

    canvas.addEventListener(
      'dblclick',
      () => {
        setScopeOnly(!scopeOnly);
      }
    );

    setMode('scope');
  } else {
    targetFps = 30;
    motionSpeed = 1;
    params.motionSpeed = motionSpeed;
    sampleStep = 4;
    glowQuality = 'off';
    fallbackCtx =
      canvas.getContext('2d');
  }

  window.addEventListener(
    'resize',
    resize
  );

  document.addEventListener(
    'visibilitychange',
    () => {
      lastFrameAt =
        0;
    }
  );

  applyFft();
  initWorker();
  resize();
  animationId =
    requestAnimationFrame(frameLoop);

  window.addEventListener(
    'beforeunload',
    () => {
      cancelAnimationFrame(animationId);
      worker?.terminate();
      void engine?.close();
    }
  );
</script>
