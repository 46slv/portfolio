---
// src/components/Visualizer.astro
// Advanced Fullscreen Visualizer

const {
  color = "#d8ff72"
} = Astro.props;
---

<div id="viz-root">
  <canvas id="viz"></canvas>

  <div id="hud">
    <div class="left">
      <div id="mode-label">
        OSCILLOSCOPE
      </div>

      <div class="stats">
        <span id="peakFreq">
          0 Hz
        </span>

        <span id="rms">
          -∞ dB
        </span>
      </div>
    </div>

    <div class="right">
      <span id="inputLabel">
        NO INPUT
      </span>
    </div>
  </div>

  <button id="panel-toggle">
    PANEL
  </button>

  <div id="panel" class="visible">

    <div class="group">
      <div class="title">
        INPUT
      </div>

      <label>
        DEVICE

        <select id="inputDevice">
        </select>
      </label>

      <label class="inline">
        <span>MONITOR</span>

        <input
          type="checkbox"
          id="monitorEnabled"
        />
      </label>

      <label>
        MONITOR LEVEL

        <input
          type="range"
          id="monitorLevel"
          min="0"
          max="1"
          step="0.001"
          value="0"
        />
      </label>
    </div>

    <div class="group">
      <div class="title">
        DISPLAY
      </div>

      <label>
        MODE

        <select id="mode">
          <option>
            OSCILLOSCOPE
          </option>

          <option>
            SPECTRUM
          </option>

          <option>
            LISSAJOUS
          </option>

          <option>
            RADIAL
          </option>

          <option>
            WATERFALL
          </option>
        </select>
      </label>

      <label class="inline">
        <span>PIXEL MAP</span>

        <input
          type="checkbox"
          id="pixelMap"
          checked
        />
      </label>

      <label>
        PERSISTENCE

        <input
          type="range"
          id="persistence"
          min="0"
          max="0.98"
          step="0.001"
          value="0.84"
        />
      </label>

      <label>
        GAIN

        <input
          type="range"
          id="gain"
          min="0.2"
          max="6"
          step="0.01"
          value="1"
        />
      </label>

      <label>
        BEAM

        <input
          type="range"
          id="beam"
          min="1"
          max="8"
          step="0.1"
          value="2"
        />
      </label>
    </div>

    <div class="group">
      <div class="title">
        FX
      </div>

      <label>
        DISTORTION

        <input
          type="range"
          id="distortion"
          min="0"
          max="1"
          step="0.001"
          value="0"
        />
      </label>

      <label>
        LPF

        <input
          type="range"
          id="lpf"
          min="100"
          max="20000"
          step="1"
          value="20000"
        />
      </label>

      <label>
        DELAY

        <input
          type="range"
          id="delayMix"
          min="0"
          max="1"
          step="0.001"
          value="0"
        />
      </label>
    </div>

  </div>
</div>

<style>
  #viz-root {
    position: relative;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: black;
  }

  #viz {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;
  }

  #hud {
    position: absolute;

    top: 16px;
    left: 16px;
    right: 16px;

    display: flex;
    justify-content: space-between;

    z-index: 50;

    color: rgba(255,255,255,0.75);

    font-family: monospace;

    pointer-events: none;
  }

  #mode-label {
    font-size: 18px;
    letter-spacing: 0.14em;
  }

  .stats {
    display: flex;
    gap: 14px;

    margin-top: 6px;

    font-size: 11px;
  }

  #panel-toggle {
    position: absolute;

    right: 20px;
    bottom: 20px;

    z-index: 100;

    background: rgba(0,0,0,0.72);

    border:
      1px solid
      rgba(255,255,255,0.08);

    color:
      rgba(255,255,255,0.7);

    padding:
      10px 14px;

    border-radius: 12px;

    font-size: 10px;
    letter-spacing: 0.18em;

    cursor: pointer;

    backdrop-filter: blur(12px);
  }

  #panel {
    position: absolute;

    left: 20px;
    bottom: 20px;

    width: 420px;

    padding: 20px;

    border-radius: 20px;

    background:
      rgba(0,0,0,0.72);

    border:
      1px solid
      rgba(255,255,255,0.08);

    backdrop-filter:
      blur(18px);

    display: flex;
    flex-direction: column;
    gap: 20px;

    z-index: 80;

    transition:
      opacity .25s ease,
      transform .25s ease;
  }

  #panel.hidden {
    opacity: 0;
    transform: translateY(10px);

    pointer-events: none;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .title {
    font-size: 10px;

    letter-spacing: 0.22em;

    color:
      rgba(255,255,255,0.45);

    font-family: monospace;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 6px;

    font-size: 10px;
    letter-spacing: 0.1em;

    color:
      rgba(255,255,255,0.72);
  }

  .inline {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  select,
  input[type="range"] {
    width: 100%;
  }

  select {
    background:
      rgba(255,255,255,0.05);

    color: white;

    border:
      1px solid
      rgba(255,255,255,0.08);

    border-radius: 10px;

    padding: 10px;
  }
</style>

<script define:vars={{ color }}>
  import { AudioEngine }
  from "../lib/audio/AudioEngine";

  const canvas =
    document.getElementById("viz");

  const ctx =
    canvas.getContext("2d");

  const engine =
    new AudioEngine();

  const modeEl =
    document.getElementById("mode");

  const pixelMapEl =
    document.getElementById("pixelMap");

  const persistenceEl =
    document.getElementById(
      "persistence"
    );

  const gainEl =
    document.getElementById("gain");

  const beamEl =
    document.getElementById("beam");

  const peakFreqEl =
    document.getElementById(
      "peakFreq"
    );

  const rmsEl =
    document.getElementById("rms");

  const panel =
    document.getElementById(
      "panel"
    );

  const panelToggle =
    document.getElementById(
      "panel-toggle"
    );

  const inputLabel =
    document.getElementById(
      "inputLabel"
    );

  let width = 0;
  let height = 0;

  let mode = "OSCILLOSCOPE";

  let pixelMap = true;

  let persistence = 0.84;

  let gain = 1;

  let beam = 2;

  function resize() {
    width =
      canvas.width =
      window.innerWidth *
      devicePixelRatio;

    height =
      canvas.height =
      window.innerHeight *
      devicePixelRatio;
  }

  resize();

  window.addEventListener(
    "resize",
    resize
  );

  async function init() {
    const devices =
      await engine.getInputDevices();

    const deviceSelect =
      document.getElementById(
        "inputDevice"
      );

    devices.forEach(device => {
      const option =
        document.createElement(
          "option"
        );

      option.value =
        device.deviceId;

      option.textContent =
        device.label ||
        "INPUT";

      deviceSelect.appendChild(
        option
      );
    });

    await engine.initInput();

    inputLabel.textContent =
      engine.stream
        ?.getAudioTracks()[0]
        ?.label || "INPUT";
  }

  function clearFrame() {
    ctx.fillStyle =
      `rgba(0,0,0,${
        1 - persistence
      })`;

    ctx.fillRect(
      0,
      0,
      width,
      height
    );
  }

  function drawPixel(
    x,
    y,
    alpha = 1
  ) {
    ctx.fillStyle =
      `rgba(216,255,114,${alpha})`;

    ctx.fillRect(
      x,
      y,
      beam,
      beam
    );
  }

  function drawOscilloscope(
    data
  ) {
    if (!pixelMap) {
      ctx.beginPath();
    }

    for (
      let i = 0;
      i < data.length;
      i++
    ) {
      const x =
        (i / data.length) * width;

      const y =
        height / 2 +
        ((data[i] - 128) / 128) *
        height *
        0.32 *
        gain;

      if (pixelMap) {
        drawPixel(x, y, 0.9);
      } else {
        if (i === 0) {
          ctx.moveTo(x, y);
        } else {
          ctx.lineTo(x, y);
        }
      }
    }

    if (!pixelMap) {
      ctx.strokeStyle = color;

      ctx.lineWidth = beam;

      ctx.shadowBlur = 12;
      ctx.shadowColor = color;

      ctx.stroke();

      ctx.shadowBlur = 0;
    }
  }

  function drawLissajous(
    data
  ) {
    ctx.beginPath();

    for (
      let i = 0;
      i < data.length;
      i++
    ) {
      const x =
        width / 2 +
        ((data[i] - 128) / 128) *
        width *
        0.3;

      const y =
        height / 2 +
        ((data[
          (i + 64) %
          data.length
        ] - 128) / 128) *
        height *
        0.3;

      ctx.lineTo(x, y);

      if (pixelMap) {
        drawPixel(x, y, 0.6);
      }
    }

    ctx.strokeStyle = color;

    ctx.lineWidth = beam;

    ctx.shadowBlur = 10;
    ctx.shadowColor = color;

    ctx.stroke();

    ctx.shadowBlur = 0;
  }

  function drawSpectrum(
    freq
  ) {
    const bars = 160;

    const step =
      Math.floor(
        freq.length / bars
      );

    for (
      let i = 0;
      i < bars;
      i++
    ) {
      const value =
        freq[i * step] / 255;

      const h =
        value *
        height *
        0.45;

      const x =
        (i / bars) * width;

      ctx.fillStyle =
        `rgba(216,255,114,${
          0.4 + value
        })`;

      ctx.fillRect(
        x,
        height - h,
        width / bars - 2,
        h
      );
    }
  }

  function render() {
    requestAnimationFrame(render);

    clearFrame();

    mode =
      modeEl.value;

    pixelMap =
      pixelMapEl.checked;

    persistence =
      Number(
        persistenceEl.value
      );

    gain =
      Number(
        gainEl.value
      );

    beam =
      Number(
        beamEl.value
      );

    const timeData =
      engine.getTimeData();

    const freqData =
      engine.getFrequencyData();

    if (
      mode ===
      "OSCILLOSCOPE"
    ) {
      drawOscilloscope(
        timeData
      );
    }

    if (
      mode ===
      "LISSAJOUS"
    ) {
      drawLissajous(
        timeData
      );
    }

    if (
      mode ===
      "SPECTRUM"
    ) {
      drawSpectrum(
        freqData
      );
    }

    const peakIndex =
      freqData.indexOf(
        Math.max(...freqData)
      );

    const peakFreq =
      peakIndex *
      engine.audioCtx
        .sampleRate /
      engine
        .frequencyAnalyser
        .fftSize;

    peakFreqEl.textContent =
      `${peakFreq.toFixed(0)} Hz`;

    let rms = 0;

    for (
      let i = 0;
      i < timeData.length;
      i++
    ) {
      const v =
        (timeData[i] - 128) /
        128;

      rms += v * v;
    }

    rms = Math.sqrt(
      rms / timeData.length
    );

    const db =
      20 *
      Math.log10(
        rms || 0.0001
      );

    rmsEl.textContent =
      `${db.toFixed(1)} dB`;
  }

  render();

  panelToggle.addEventListener(
    "click",
    () => {
      panel.classList.toggle(
        "hidden"
      );
    }
  );

  window.addEventListener(
    "keydown",
    e => {
      if (e.key === "Tab") {
        e.preventDefault();

        panel.classList.toggle(
          "hidden"
        );
      }
    }
  );

  document
    .getElementById(
      "monitorEnabled"
    )
    .addEventListener(
      "change",
      e => {
        if (!e.target.checked) {
          engine.setMonitorLevel(
            0
          );
        } else {
          engine.setMonitorLevel(
            Number(
              document
                .getElementById(
                  "monitorLevel"
                ).value
            )
          );
        }
      }
    );

  document
    .getElementById(
      "monitorLevel"
    )
    .addEventListener(
      "input",
      e => {
        if (
          document.getElementById(
            "monitorEnabled"
          ).checked
        ) {
          engine.setMonitorLevel(
            Number(
              e.target.value
            )
          );
        }
      }
    );

  document
    .getElementById(
      "inputDevice"
    )
    .addEventListener(
      "change",
      async e => {
        await engine.initInput(
          e.target.value
        );
      }
    );

  document
    .getElementById(
      "distortion"
    )
    .addEventListener(
      "input",
      e => {
        engine.setDistortion(
          Number(
            e.target.value
          )
        );
      }
    );

  document
    .getElementById(
      "lpf"
    )
    .addEventListener(
      "input",
      e => {
        engine.setLPF(
          Number(
            e.target.value
          )
        );
      }
    );

  document
    .getElementById(
      "delayMix"
    )
    .addEventListener(
      "input",
      e => {
        engine.setDelayMix(
          Number(
            e.target.value
          )
        );
      }
    );

  init();
</script>