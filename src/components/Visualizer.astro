---
import { MODES, QUALITIES } from '../lib/visualizer/model';
interface Props { color?: string; }
const { color = '#36ff72' } = Astro.props;
---
<div class="visualizer-root" data-visualizer data-color={color} style={`--accent:${color}`}>
  <header class="scope-header">
    <a href="/" class="back-link">← BACK</a>
    <h1>SS_SCOPE <span>/ AUDIO OBSERVATORY</span></h1>
    <div class="header-actions">
      <button id="focus-btn" type="button" aria-pressed="false">Focus view</button>
      <button id="fullscreen-btn" type="button">Fullscreen</button>
    </div>
  </header>
  <main class="scope-main">
    <section class="workspace" aria-label="Audio visualization">
      <div class="source-strip">
        <span class="source-status" id="source-status" role="status" aria-live="polite">Idle · choose a source</span>
        <div class="source-buttons">
          <button id="demo-btn" type="button">Start demo</button>
          <button id="mic-btn" class="primary-button" type="button">Use microphone</button>
          <button id="stop-btn" type="button" disabled>Stop</button>
        </div>
      </div>
      <div class="stage" id="visualizer-stage">
        <canvas id="visualizer-canvas" aria-label="Audio trace. Choose a source to begin.">Audio visualization requires Canvas 2D.</canvas>
        <div class="idle-message" id="idle-message">
          <span class="idle-mark" aria-hidden="true">∿</span>
          <p>See the shape of sound.</p>
          <span>Try the silent demo, or connect a microphone.</span>
          <span>No microphone access until you choose it.</span>
        </div>
        <button id="focus-exit" type="button" hidden>Exit focus · Esc</button>
      </div>
      <div class="workspace-caption">
        <span id="mode-caption">Amplitude over time. The center line is zero.</span>
        <span id="source-tag">NO SIGNAL</span>
      </div>
      <p id="renderer-notice" role="status" hidden></p>
    </section>
    <aside class="controls" aria-label="Visualizer controls">
      <section class="control-section">
        <h2>Input</h2>
        <label for="demo-select">Demo signal</label>
        <select id="demo-select">
          <option value="phase90">Stereo · 90° phase</option>
          <option value="mono">Mono · same L / R</option>
          <option value="antiphase">Stereo · antiphase</option>
          <option value="ratio12">Stereo · ratio 1:2</option>
          <option value="silentRight">Stereo · silent right</option>
        </select>
        <label for="input-select">Microphone</label>
        <select id="input-select"><option value="">System default</option></select>
        <p class="help-text" id="input-policy">Raw signal. Known mono inputs use L on both axes; stereo silence is preserved.</p>
        <label class="range-label" for="monitor">Monitor <output id="monitor-value" for="monitor">Muted</output></label>
        <input id="monitor" type="range" min="0" max="1" step="0.01" value="0" disabled aria-describedby="monitor-warning" />
        <p class="help-text" id="monitor-warning">Muted by default. Use headphones before raising it.</p>
      </section>
      <section class="control-section">
        <h2>View</h2>
        <div class="primary-modes" role="group" aria-label="Primary display mode">
          {(['scope', 'spectrum', 'lissajous'] as const).map(mode => <button type="button" class="mode-btn" data-mode={mode} aria-pressed={mode === 'scope' ? 'true' : 'false'}>{MODES[mode].label}</button>)}
        </div>
        <label for="more-mode">Presentation modes</label>
        <select id="more-mode">
          <option value="">Choose a secondary mode</option>
          {(['radial', 'waterfall', 'particle'] as const).map(mode => <option value={mode}>{MODES[mode].label}</option>)}
        </select>
        <label for="quality">Quality budget</label>
        <select id="quality">{Object.entries(QUALITIES).map(([value, preset]) => <option value={value} selected={value === 'balanced'}>{preset.label}</option>)}</select>
        <label class="range-label" for="gain">Display gain <output id="gain-value" for="gain">1.0×</output></label>
        <input id="gain" type="range" min="0.25" max="4" step="0.05" value="1" />
        <div data-control="window">
          <label for="time-window">Trace window</label>
          <select id="time-window"><option value="256">Short · 256 samples</option><option value="512" selected>Medium · 512 samples</option><option value="1024">Long · 1024 samples</option></select>
        </div>
        <div data-control="trail">
          <label class="range-label" for="trail">Persistence <output id="trail-value" for="trail">Off</output></label>
          <input id="trail" type="range" min="0" max="0.6" step="0.02" value="0" />
        </div>
        <label class="check-label" data-control="grid"><input id="grid" type="checkbox" checked /> Reference grid</label>
      </section>
      <details class="control-section" open>
        <summary>Appearance</summary>
        <label for="color-select">Color</label>
        <select id="color-select">
          <option value="#36ff72" selected>VECTOR GREEN</option><option value="#ffb000">AMBER CRT</option>
          <option value="#7fd8ff">ICE BLUE</option><option value="#ff4dff">LASER MAGENTA</option>
          <option value="#ffff00">ACID YELLOW</option><option value="#f4f4f4">TERMINAL WHITE</option>
          <option value="custom" disabled>CUSTOM</option>
        </select>
        <label class="range-label" for="hue">Hue <output id="hue-value" for="hue">138°</output></label>
        <input id="hue" type="range" min="0" max="360" step="any" value="137.910447761194" />
        <label class="range-label" for="beam">Line width <output id="beam-value" for="beam">1.0×</output></label>
        <input id="beam" type="range" min="0.4" max="3" step="0.1" value="1" />
        <label class="range-label" for="glow">Glow <output id="glow-value" for="glow">Off</output></label>
        <input id="glow" type="range" min="0" max="2" step="0.1" value="0" />
        <label class="check-label"><input id="crt" type="checkbox" /> CRT scanlines</label>
      </details>
      <details class="control-section diagnostics" id="diagnostics">
        <summary>Diagnostics</summary>
        <dl><dt>Renderer</dt><dd id="metric-renderer">Starting</dd><dt>Output / last second</dt><dd id="metric-fps">0 frames</dd>
          <dt>Actual draw cost</dt><dd id="metric-draw">—</dd><dt>Skipped while busy</dt><dd id="metric-busy">0</dd>
          <dt>Backing resolution</dt><dd id="metric-size">—</dd><dt>Signal RMS</dt><dd id="metric-rms">—</dd><dt>L / R correlation</dt><dd id="metric-phase">—</dd></dl>
        <p class="help-text">Output counts renderer acknowledgements, not display refresh. Draw cost excludes capture and messaging.</p>
      </details>
      <button id="reset-btn" type="button">Reset view & appearance</button>
      <p class="help-text reset-note">Does not start or change your source.</p>
    </aside>
  </main>
</div>
<script>
  import { mountVisualizer } from '../scripts/visualizer';
  document.querySelectorAll<HTMLElement>('[data-visualizer]').forEach((root) => mountVisualizer(root));
</script>
<style>
  .visualizer-root { --accent:#36ff72; color:#e7eae7; background:#030504; min-height:100dvh; font-family:ui-monospace,SFMono-Regular,Consolas,monospace; font-size:12px; }
  * { box-sizing:border-box; }
  button, select, input { font:inherit; }
  button, select { min-height:36px; border:1px solid #344038; border-radius:3px; background:#0b100d; color:#e7eae7; }
  button { cursor:pointer; padding:8px 11px; transition:border-color .15s,color .15s; }
  button:hover:not(:disabled) { color:var(--accent); border-color:var(--accent); }
  button:disabled { opacity:.4; cursor:default; }
  button[aria-pressed="true"], .primary-button { border-color:var(--accent); color:var(--accent); }
  :is(button,select,input,a,summary):focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
  .scope-header { display:flex; align-items:center; gap:24px; height:66px; padding:12px 24px; border-bottom:1px solid #253028; }
  .back-link { color:#c1c9c2; text-decoration:none; white-space:nowrap; font-size:11px; }
  h1 { margin:0; font-size:13px; font-weight:500; letter-spacing:.12em; }
  h1 span { color:#85978a; font-size:10px; margin-left:8px; }
  .header-actions { display:flex; gap:8px; margin-left:auto; }
  .scope-main { display:grid; grid-template-columns:minmax(0,1fr) 300px; min-height:calc(100dvh - 66px); }
  .workspace { min-width:0; display:flex; flex-direction:column; padding:20px 24px 12px; }
  .source-strip { display:flex; align-items:center; gap:16px; min-height:42px; margin-bottom:16px; }
  .source-status { flex:1; min-width:0; color:#9cad9f; font-size:11px; }
  .source-buttons { display:flex; gap:8px; }
  .stage { position:relative; flex:1; min-height:300px; background:#000; border:1px solid #1e2d23; overflow:hidden; }
  canvas { display:block; position:absolute; inset:0; width:100%; height:100%; }
  .idle-message { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:10px; color:#93a397; pointer-events:none; text-align:center; padding:24px; }
  .idle-mark { color:var(--accent); font-size:60px; font-family:serif; line-height:1; }
  .idle-message p { font-size:18px; color:#e7eae7; margin:12px 0; letter-spacing:.03em; }
  .idle-message span:not(.idle-mark) { font-size:11px; line-height:1.6; }
  [hidden] { display:none !important; }
  .workspace-caption { display:flex; justify-content:space-between; gap:20px; padding-top:12px; min-height:44px; line-height:1.6; color:#9cad9f; font-size:10px; }
  #source-tag { white-space:nowrap; color:var(--accent); letter-spacing:.07em; }
  #renderer-notice { margin:4px 0; color:#e6bd7b; font-size:11px; }
  .controls { padding:20px; border-left:1px solid #253028; background:#090d0a; }
  .control-section { padding-bottom:20px; margin-bottom:20px; border-bottom:1px solid #253028; }
  h2, summary { margin:0 0 15px; font-size:11px; letter-spacing:.12em; color:#ced8d0; font-weight:500; text-transform:uppercase; }
  summary { cursor:pointer; min-height:24px; }
  details:not([open]) summary { margin-bottom:0; }
  label { display:block; margin:13px 0 7px; color:#afbeb2; font-size:11px; }
  select { width:100%; padding:7px 9px; }
  input[type="range"] { display:block; width:100%; min-height:26px; margin:0; accent-color:var(--accent); cursor:pointer; }
  input:disabled { opacity:.4; cursor:default; }
  .range-label { display:flex; justify-content:space-between; gap:8px; }
  output { color:#e0e8e2; font-variant-numeric:tabular-nums; }
  .check-label { display:flex; align-items:center; gap:9px; min-height:28px; cursor:pointer; }
  input[type="checkbox"] { width:15px; height:15px; accent-color:var(--accent); margin:0; }
  .primary-modes { display:grid; grid-template-columns:1fr 1.4fr 1fr; gap:6px; }
  .primary-modes button { padding:8px 5px; }
  .help-text { color:#8d9d91; line-height:1.7; font-size:10px; margin:8px 0 0; }
  .reset-note { margin-bottom:0; }
  #reset-btn { width:100%; }
  dl { display:grid; grid-template-columns:1fr 1fr; gap:10px 8px; margin:0; font-size:10px; line-height:1.5; }
  dt { color:#8d9d91; } dd { margin:0; text-align:right; color:#dce5de; overflow-wrap:anywhere; }
  .crt .stage::after { content:""; position:absolute; inset:0; pointer-events:none; background:repeating-linear-gradient(0deg,transparent 0 3px,#0005 3px 4px); opacity:.5; }
  #focus-exit { position:absolute; top:max(16px,env(safe-area-inset-top)); right:max(16px,env(safe-area-inset-right)); z-index:2; opacity:.7; }
  #focus-exit:hover, #focus-exit:focus-visible { opacity:1; }
  .is-focused { position:fixed; inset:0; z-index:1000; }
  .is-focused .scope-header, .is-focused .controls, .is-focused .source-strip, .is-focused .workspace-caption, .is-focused #renderer-notice { display:none; }
  .is-focused .scope-main { display:block; min-height:100dvh; height:100dvh; }
  .is-focused .workspace { padding:0; height:100%; }
  .is-focused .stage { border:0; }
  @media (min-width:901px) { .visualizer-root { height:100dvh; overflow:hidden; } .scope-main { height:calc(100dvh - 66px); } .controls { overflow-y:auto; scrollbar-width:thin; } }
  @media (max-width:1100px) { .scope-header { gap:16px; } h1 span { display:none; } .source-strip { align-items:flex-start; flex-direction:column; gap:10px; } }
  @media (max-width:900px) {
    .scope-header { height:auto; min-height:60px; padding:calc(12px + env(safe-area-inset-top)) max(14px,env(safe-area-inset-right)) 12px max(14px,env(safe-area-inset-left)); gap:14px; flex-wrap:wrap; }
    .scope-header h1 { font-size:11px; } .header-actions { gap:6px; } .header-actions button { padding:7px 9px; font-size:10px; }
    .scope-main { display:flex; flex-direction:column; min-height:0; }
    .workspace { padding:16px max(14px,env(safe-area-inset-right)) 8px max(14px,env(safe-area-inset-left)); }
    .stage { flex:none; height:50svh; min-height:260px; }
    .source-strip { gap:10px; margin-bottom:12px; } .source-buttons { width:100%; } .source-buttons button { flex:1; }
    .controls { border-left:0; border-top:1px solid #253028; padding:20px max(20px,env(safe-area-inset-right)) calc(24px + env(safe-area-inset-bottom)) max(20px,env(safe-area-inset-left)); }
    .workspace-caption { gap:12px; } .is-focused .stage { flex:1; height:auto; }
  }
  @media (prefers-reduced-motion:reduce) { button { transition:none; } }
</style>
