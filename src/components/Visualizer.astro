---
// src/component/Visualizer.astro — SS_SCOPE v4.0
interface Props {
  isMini?: boolean;
  color?: string;
}
const { isMini = false, color = '#ffff00' } = Astro.props;
---

<div
  class={`visualizer-root ${isMini ? 'mini-mode' : 'fullscreen-mode'}`}
  data-mini={isMini ? 'true' : 'false'}
  data-color={color}
>
  <canvas id="visualizer-canvas"></canvas>
  {!isMini && <div id="perf-overlay"></div>}

  {!isMini && (
    <div id="viz-ui">

      <!-- ══ TOP HUD ══ -->
      <div id="hud-bar">
        <div id="hud-left">
          <span id="hud-title">SS_SCOPE v4.0</span>
          <div id="hud-status">
            <div id="status-dot"></div>
            <span id="status-label">STANDBY</span>
          </div>
        </div>
        <div id="hud-center">
          <span id="hud-freq">FREQ: ---Hz</span>
          <span id="hud-rms">RMS: -∞dB</span>
          <span id="hud-mode-label">MODE: SCOPE</span>
          <span id="hud-perf">FPS: --/60 | --ms | DROP 0</span>
        </div>
        <div id="hud-right">
          <button id="panel-toggle-btn" title="Toggle panel (Tab)">PANEL ▾</button>
        </div>
      </div>

      <!-- ══ BOTTOM CONTROL PANEL ══ -->
      <div id="control-panel">
        <div id="panel-inner">

          <div id="design-panel">
            <details class="panel-section primary-section" open>
              <summary>Primary</summary>
              <div class="primary-grid">
                {[
                  { id:'design-volume', label:'Volume', value:'0', min:'0', max:'1', fmt:'pct' },
                  { id:'design-speed', label:'Speed', value:'1', min:'0.5', max:'8', fmt:'x1' },
                  { id:'design-scale', label:'Scale', value:'1', min:'0.1', max:'3', fmt:'x1' },
                  { id:'design-beam', label:'Beam', value:'1', min:'0.4', max:'3', fmt:'x1' },
                  { id:'design-intensity', label:'Intensity', value:'1', min:'0.2', max:'2', fmt:'x1' },
                  { id:'design-afterglow', label:'Afterglow', value:'0.15', min:'0', max:'0.95', fmt:'pct' },
                  { id:'design-x', label:'↔ Expand', value:'1', min:'0.5', max:'2', fmt:'x1' },
                  { id:'design-y', label:'↕ Expand', value:'1', min:'0.5', max:'2', fmt:'x1' },
                  { id:'design-rotate', label:'Rotate', value:'0', min:'-180', max:'180', fmt:'deg', bipolar:'true' },
                ].map(k => (
                  <div class="design-knob-wrap">
                    <canvas
                      class="design-knob"
                      data-id={k.id}
                      data-min={k.min}
                      data-max={k.max}
                      data-val={k.value}
                      data-fmt={k.fmt}
                      data-bipolar={k.bipolar}
                    ></canvas>
                    <span class="design-label">{k.label}</span>
                    <span class="design-value" data-for={k.id}></span>
                  </div>
                ))}
              </div>
            </details>

            <details class="panel-section" open>
              <summary>Mode</summary>
              <div class="mode-panel">
                <div class="btn-group mode-selector">
                  {[
                    { id:'scope', label:'OSC' },
                    { id:'spectrum', label:'SPECTRUM' },
                    { id:'lissajous', label:'LISSAJOUS' },
                    { id:'radial', label:'RADIAL' },
                    { id:'waterfall', label:'WATERFALL' },
                  ].map(m => (
                    <button class="mode-btn design-mode-btn" data-mode={m.id}>{m.label}</button>
                  ))}
                </div>
                <div class="mode-tools">
                  <button id="design-pixelmap" class="toggle-btn visual-toggle" data-active="false">PIXEL MAP</button>
                  <button id="design-hud" class="toggle-btn visual-toggle" data-active="true">HUD</button>
                  <button id="design-wave-only" class="toggle-btn visual-toggle" data-active="false">WAVE ONLY</button>
                  <button id="design-reset" class="toggle-btn visual-toggle">RESET</button>
                </div>
                <div class="utility-strip">
                  <select id="design-input-select" class="viz-select">
                    <option value="">— mic —</option>
                  </select>
                  <button id="design-start-btn">▶ ENGAGE</button>
                  <button id="design-stop-btn" class="hidden">■ STOP</button>
                  <span id="design-init-hint">mic standby</span>
                </div>
              </div>
            </details>

            <details class="panel-section">
              <summary>Color</summary>
              <div class="color-grid">
                <label>Preset
                  <select id="design-color-select" class="viz-select compact-select">
                    <option value="#36ff72" selected>VECTOR GREEN</option>
                    <option value="#ffb000">AMBER CRT</option>
                    <option value="#7fd8ff">ICE BLUE</option>
                    <option value="#ff4dff">LASER MAGENTA</option>
                    <option value="#ffff00">ACID YELLOW</option>
                    <option value="#f4f4f4">TERMINAL WHITE</option>
                  </select>
                </label>
                <div class="design-knob-wrap compact-knob">
                  <canvas class="design-knob" data-id="design-hue" data-min="0" data-max="360" data-val="60" data-fmt="deg"></canvas>
                  <span class="design-label">Hue</span>
                  <span class="design-value" data-for="design-hue"></span>
                </div>
              </div>
            </details>

            <details class="panel-section">
              <summary>Advanced</summary>
              <div id="advanced-grid">
                <label>FPS
                  <select id="design-fps-select" class="viz-select compact-select">
                    {[15,24,30,60,120].map(v => <option value={v} selected={v === 60}>{v}</option>)}
                  </select>
                </label>
                <label>Quality
                  <select id="design-glow-select" class="viz-select compact-select">
                    <option value="off">OFF</option>
                    <option value="low" selected>LOW</option>
                    <option value="high">HIGH</option>
                  </select>
                </label>
                <label>FFT
                  <select id="design-fft-select" class="viz-select compact-select">
                    <option value="auto" selected>AUTO</option>
                    <option value="512">512</option>
                    <option value="1024">1024</option>
                    <option value="2048">2048</option>
                    <option value="4096">4096</option>
                  </select>
                </label>
                <label>Density
                  <select id="design-sample-select" class="viz-select compact-select">
                    <option value="1" selected>1:1</option>
                    <option value="2">1:2</option>
                    <option value="4">1:4</option>
                    <option value="8">1:8</option>
                  </select>
                </label>
                <label>Render
                  <select id="design-scale-select" class="viz-select compact-select">
                    <option value="1" selected>1.0</option>
                    <option value="0.75">0.75</option>
                    <option value="0.5">0.5</option>
                  </select>
                </label>
                <button id="design-adaptive" class="toggle-btn" data-active="false">ADAPT</button>
                <button id="design-stats" class="toggle-btn" data-active="false">STATS</button>
                <button id="design-ultra" class="toggle-btn" data-active="false">ULTRA</button>
              </div>
            </details>
          </div>

          <!-- Mode row -->
          <div id="mode-row">
            <span class="section-label" style="border:none;margin:0;">DISPLAY</span>
            <div class="btn-group">
              {[
                { id:'scope',      label:'OSCILLOSCOPE' },
                { id:'spectrum',   label:'SPECTRUM' },
                { id:'lissajous',  label:'LISSAJOUS' },
                { id:'radial',     label:'RADIAL' },
                { id:'waterfall',  label:'WATERFALL' },
                { id:'particle',   label:'PARTICLE' },
              ].map(m => (
                <button class="mode-btn" data-mode={m.id}>{m.label}</button>
              ))}
            </div>
            <div class="btn-group" style="margin-left:auto;">
              <span class="section-label" style="border:none;margin:0;padding:0;">OVERLAY</span>
              <button id="pixelmap-btn" class="toggle-btn" data-active="false">PIXEL MAP</button>
            </div>
          </div>

          <div id="perf-row">
            <span class="section-label" style="border:none;margin:0;padding:0;">PERF</span>
            <label>FPS
              <select id="fps-select" class="viz-select compact-select">
                {[15,24,30,60,120].map(v => <option value={v} selected={v === 60}>{v}</option>)}
              </select>
            </label>
            <label>SCALE
              <select id="scale-select" class="viz-select compact-select">
                <option value="1" selected>1.0</option>
                <option value="0.75">0.75</option>
                <option value="0.5">0.5</option>
              </select>
            </label>
            <label>SAMPLE
              <select id="sample-select" class="viz-select compact-select">
                <option value="1" selected>1:1</option>
                <option value="2">1:2</option>
                <option value="4">1:4</option>
                <option value="8">1:8</option>
              </select>
            </label>
            <label>FFT
              <select id="fft-select" class="viz-select compact-select">
                <option value="auto" selected>AUTO</option>
                <option value="512">512</option>
                <option value="1024">1024</option>
                <option value="2048">2048</option>
                <option value="4096">4096</option>
              </select>
            </label>
            <label>GLOW
              <select id="glow-select" class="viz-select compact-select">
                <option value="off">OFF</option>
                <option value="low" selected>LOW</option>
                <option value="high">HIGH</option>
              </select>
            </label>
            <label>COLOR
              <select id="color-select" class="viz-select compact-select">
                <option value="#36ff72" selected>VECTOR</option>
                <option value="#ffb000">AMBER</option>
                <option value="#7fd8ff">ICE</option>
                <option value="#ff4dff">MAGENTA</option>
                <option value="#ffff00">ACID</option>
                <option value="#f4f4f4">WHITE</option>
              </select>
            </label>
            <button id="adaptive-btn" class="toggle-btn" data-active="false">ADAPT</button>
            <button id="perf-overlay-btn" class="toggle-btn" data-active="false">STATS</button>
            <button id="scope-only-btn" class="toggle-btn" data-active="false">SCOPE ONLY</button>
            <button id="ultra-btn" class="toggle-btn" data-active="false">ULTRA</button>
          </div>

          <!-- Main controls grid -->
          <div id="controls-grid">

            <!-- ── I/O ── -->
            <div class="ctrl-section">
              <div class="section-label">I / O</div>
              <div class="ctrl-row">
                <span class="ctrl-label">INPUT</span>
                <select id="input-select" class="viz-select">
                  <option value="">— mic —</option>
                </select>
              </div>
              <div class="ctrl-row" style="margin-top:10px;">
                <span class="ctrl-label">OUT VOL</span>
                <canvas class="knob-canvas" data-id="out-vol"  data-min="0"   data-max="1"     data-val="0"     data-fmt="pct"></canvas>
                <span class="knob-val" data-for="out-vol">0%</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">MIC GAIN</span>
                <canvas class="knob-canvas" data-id="gain"     data-min="0.1" data-max="5"     data-val="1"     data-fmt="x2"></canvas>
                <span class="knob-val" data-for="gain">1.00×</span>
              </div>
              <button id="start-btn">▶ ENGAGE</button>
              <button id="stop-btn" class="hidden">■ STOP</button>
              <span id="init-hint">mic standby</span>
            </div>

            <!-- ── SCOPE ── -->
            <div class="ctrl-section">
              <div class="section-label">SCOPE</div>
              <div class="ctrl-row">
                <span class="ctrl-label">TIMEBASE</span>
                <canvas class="knob-canvas" data-id="zoom"     data-min="0.5" data-max="8"     data-val="1"     data-fmt="x1"></canvas>
                <span class="knob-val" data-for="zoom">1.0×</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">V/DIV</span>
                <canvas class="knob-canvas" data-id="vdiv"     data-min="0.1" data-max="3"     data-val="1"     data-fmt="x1"></canvas>
                <span class="knob-val" data-for="vdiv">1.0×</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">PERSIST</span>
                <canvas class="knob-canvas" data-id="persist"  data-min="0"   data-max="0.95"  data-val="0.15"  data-fmt="pct"></canvas>
                <span class="knob-val" data-for="persist">15%</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">TRIG LVL</span>
                <canvas class="knob-canvas" data-id="triglvl"  data-min="-1"  data-max="1"     data-val="0"     data-fmt="x1" data-bipolar="true"></canvas>
                <span class="knob-val" data-for="triglvl">0.0×</span>
              </div>
              <div class="toggle-row">
                <button class="toggle-btn" id="btn-grid"   data-active="true">GRID</button>
                <button class="toggle-btn" id="btn-trig"   data-active="false">TRIG</button>
                <button class="toggle-btn" id="btn-invert" data-active="false">INV</button>
              </div>
            </div>

            <!-- ── SYNTH ── -->
            <div class="ctrl-section">
              <div class="section-label">SYNTH OSC</div>
              <div class="btn-group" id="osc-btns" style="flex-wrap:wrap;margin-bottom:8px;">
                {['OFF','SINE','SAW','SQR','TRI','NOISE'].map(t => (
                  <button class="osc-btn" data-osc={t}>{t}</button>
                ))}
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">FREQ</span>
                <canvas class="knob-canvas" data-id="osc-freq"   data-min="20"  data-max="2000"  data-val="440"  data-fmt="hz" data-log="true"></canvas>
                <span class="knob-val" data-for="osc-freq">440Hz</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">DETUNE</span>
                <canvas class="knob-canvas" data-id="osc-detune" data-min="-100" data-max="100"  data-val="0"    data-fmt="ct" data-bipolar="true"></canvas>
                <span class="knob-val" data-for="osc-detune">0¢</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">LEVEL</span>
                <canvas class="knob-canvas" data-id="osc-vol"    data-min="0"   data-max="1"     data-val="0.3"  data-fmt="pct"></canvas>
                <span class="knob-val" data-for="osc-vol">30%</span>
              </div>
            </div>

            <!-- ── FX ── -->
            <div class="ctrl-section">
              <div class="section-label">FX CHAIN</div>
              <div class="ctrl-row">
                <span class="ctrl-label">DRIVE</span>
                <canvas class="knob-canvas" data-id="dist"       data-min="0"   data-max="400"   data-val="0"    data-fmt="raw"></canvas>
                <span class="knob-val" data-for="dist">0</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">DLY TIME</span>
                <canvas class="knob-canvas" data-id="delay-time" data-min="0.01" data-max="1"    data-val="0.25" data-fmt="s"></canvas>
                <span class="knob-val" data-for="delay-time">250ms</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">DLY MIX</span>
                <canvas class="knob-canvas" data-id="delay-mix"  data-min="0"   data-max="1"     data-val="0"    data-fmt="pct"></canvas>
                <span class="knob-val" data-for="delay-mix">0%</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">LPF</span>
                <canvas class="knob-canvas" data-id="lpf"        data-min="100" data-max="20000" data-val="20000" data-fmt="hz" data-log="true"></canvas>
                <span class="knob-val" data-for="lpf">20kHz</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">HPF</span>
                <canvas class="knob-canvas" data-id="hpf"        data-min="10"  data-max="5000"  data-val="10"   data-fmt="hz" data-log="true"></canvas>
                <span class="knob-val" data-for="hpf">10Hz</span>
              </div>
            </div>

            <!-- ── PIXEL MAP ── -->
            <div class="ctrl-section">
              <div class="section-label">PIXEL MAP</div>
              <div class="ctrl-row">
                <span class="ctrl-label">SIZE</span>
                <canvas class="knob-canvas" data-id="px-size"    data-min="2"   data-max="20"    data-val="4"    data-fmt="raw"></canvas>
                <span class="knob-val" data-for="px-size">4px</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">THRESH</span>
                <canvas class="knob-canvas" data-id="px-thresh"  data-min="0"   data-max="1"     data-val="0.15" data-fmt="pct"></canvas>
                <span class="knob-val" data-for="px-thresh">15%</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">OPACITY</span>
                <canvas class="knob-canvas" data-id="px-opacity" data-min="0.1" data-max="1"     data-val="0.7"  data-fmt="pct"></canvas>
                <span class="knob-val" data-for="px-opacity">70%</span>
              </div>
              <div class="ctrl-row">
                <span class="ctrl-label">GAP</span>
                <canvas class="knob-canvas" data-id="px-gap"     data-min="0"   data-max="6"     data-val="1"    data-fmt="raw"></canvas>
                <span class="knob-val" data-for="px-gap">1</span>
              </div>
            </div>

          </div><!-- /controls-grid -->
        </div><!-- /panel-inner -->
      </div><!-- /control-panel -->

    </div><!-- /viz-ui -->
  )}
</div>

<style>
  .visualizer-root { position:relative; width:100%; height:100%; min-height:100dvh; overflow:hidden; }
  .fullscreen-mode { background:#000; }
  .mini-mode canvas { cursor:pointer; }
  canvas#visualizer-canvas { display:block; width:100%; height:100%; touch-action:none; }

  #viz-ui { position:absolute; inset:0; pointer-events:none; font-family:'Courier New',monospace; }

  /* ── HUD ── */
  #hud-bar {
    position:absolute; top:0; left:0; right:0;
    display:flex; align-items:center; justify-content:space-between;
    padding:10px 20px;
    background:linear-gradient(to bottom,rgba(0,0,0,0.88) 0%,transparent 100%);
    pointer-events:auto;
  }
  #hud-left  { display:flex; align-items:center; gap:16px; }
  #hud-title { font-size:9px; letter-spacing:.5em; font-weight:700; color:#ffff00; text-transform:uppercase; }
  #hud-status { display:flex; align-items:center; gap:6px; }
  #status-dot { width:6px; height:6px; border-radius:50%; background:#ffff00; animation:blink 2s infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.25} }
  #status-label { font-size:8px; color:#555; letter-spacing:.4em; text-transform:uppercase; }
  #hud-center { display:flex; gap:20px; font-size:9px; color:#555; letter-spacing:.1em; }
  #hud-right  { pointer-events:auto; }

  #panel-toggle-btn {
    font-size:8px; font-family:inherit; letter-spacing:.3em; text-transform:uppercase;
    color:#555; background:transparent; border:1px solid #2a2a2a;
    padding:5px 12px; cursor:pointer; transition:all .2s;
  }
  #panel-toggle-btn:hover, #panel-toggle-btn.panel-visible { color:#ffff00; border-color:#555; }

  /* ── Panel ── */
  #control-panel {
    position:absolute; bottom:0; left:0; right:0;
    background:linear-gradient(to top,rgba(0,0,0,.97) 0%,rgba(0,0,0,.82) 80%,transparent 100%);
    pointer-events:auto;
    transform:translateY(0);
    transition:transform .35s cubic-bezier(.4,0,.2,1);
    max-height:calc(100dvh - env(safe-area-inset-top) - 18px);
    overflow:hidden;
  }
  #control-panel.hidden { transform:translateY(100%); pointer-events:none; }
  #panel-inner {
    padding:28px 20px calc(14px + env(safe-area-inset-bottom));
    max-height:inherit;
    overflow-y:auto;
    overscroll-behavior:contain;
    -webkit-overflow-scrolling:touch;
    touch-action:pan-y;
    scrollbar-width:thin;
    scrollbar-color:#333 transparent;
  }
  #panel-inner::-webkit-scrollbar { width:6px; }
  #panel-inner::-webkit-scrollbar-track { background:transparent; }
  #panel-inner::-webkit-scrollbar-thumb { background:#222; border-radius:999px; }
  #mode-row, #perf-row, #controls-grid { display:none !important; }

  #design-panel {
    display:grid; grid-template-columns:minmax(0,1.7fr) minmax(240px,.9fr) minmax(180px,.55fr) minmax(220px,.7fr);
    gap:14px; align-items:start; padding-right:4px;
    scrollbar-width:thin; scrollbar-color:#333 transparent;
  }
  #design-panel::-webkit-scrollbar { width:6px; }
  #design-panel::-webkit-scrollbar-track { background:transparent; }
  #design-panel::-webkit-scrollbar-thumb { background:#222; border-radius:999px; }
  .panel-section { border-left:1px solid #181818; padding-left:14px; min-width:0; }
  .panel-section:first-child { border-left:none; padding-left:0; }
  .panel-section summary {
    cursor:pointer; list-style:none; font-size:10px; letter-spacing:.34em; color:#777;
    text-transform:uppercase; margin-bottom:12px; user-select:none;
  }
  .panel-section summary::-webkit-details-marker { display:none; }
  .panel-section summary::before { content:'▾'; display:inline-block; margin-right:8px; color:#ffff00; }
  .panel-section:not([open]) summary::before { content:'▸'; }
  .primary-grid {
    display:grid; grid-template-columns:repeat(3,minmax(74px,1fr)); gap:12px 14px;
  }
  .design-knob-wrap { display:grid; justify-items:center; gap:4px; min-width:0; }
  .design-knob { width:58px !important; height:58px !important; cursor:ns-resize; touch-action:none; }
  .design-label { font-size:10px; color:#666; letter-spacing:.14em; text-transform:uppercase; text-align:center; }
  .design-value { font-size:11px; color:#9a9a9a; letter-spacing:.08em; min-height:13px; }
  .mode-panel, .color-grid, #advanced-grid { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
  .mode-selector { gap:5px; }
  .mode-tools { display:flex; flex-wrap:wrap; gap:5px; width:100%; }
  .visual-toggle { min-height:26px; }
  .utility-strip { display:flex; flex-wrap:wrap; align-items:center; gap:7px; width:100%; margin-top:4px; }
  #design-start-btn, #design-stop-btn {
    font-size:9px; font-family:inherit; letter-spacing:.24em; text-transform:uppercase;
    padding:6px 10px; cursor:pointer; border:1px solid #ffff00; color:#ffff00; background:transparent;
  }
  #design-start-btn:hover { background:#ffff00; color:#000; }
  #design-stop-btn { border-color:#333; color:#555; }
  #design-stop-btn.hidden { display:none; }
  #design-init-hint { font-size:8px; color:#444; font-style:italic; }
  #advanced-grid label, .color-grid label {
    display:flex; align-items:center; gap:6px; font-size:8px; color:#666; letter-spacing:.18em; text-transform:uppercase;
  }
  .compact-knob .design-knob { width:48px !important; height:48px !important; }

  /* Mode row */
  #mode-row {
    display:flex; align-items:center; gap:10px; margin-bottom:14px; flex-wrap:wrap;
  }
  #perf-row {
    display:flex; align-items:center; gap:8px; margin-bottom:14px; flex-wrap:wrap;
    font-size:7px; color:#555; letter-spacing:.2em; text-transform:uppercase;
  }
  #perf-row label { display:flex; align-items:center; gap:5px; }
  .btn-group { display:flex; gap:3px; flex-wrap:wrap; }
  .section-label {
    font-size:7px; letter-spacing:.4em; color:#3a3a3a; text-transform:uppercase;
    border-bottom:1px solid #1c1c1c; padding-bottom:4px; margin-bottom:8px; display:block;
  }

  /* Buttons */
  .mode-btn, .osc-btn, .toggle-btn {
    font-size:7px; font-family:inherit; letter-spacing:.25em; text-transform:uppercase;
    background:transparent; border:1px solid #252525; color:#3a3a3a;
    padding:4px 8px; cursor:pointer; transition:all .15s;
  }
  .mode-btn:hover, .osc-btn:hover, .toggle-btn:hover { border-color:#555; color:#888; }
  .mode-btn.active  { border-color:#ffff00; color:#ffff00; background:rgba(255,255,0,.04); }
  .osc-btn.active   { border-color:#ffff00; color:#000;    background:#ffff00; }
  .toggle-btn[data-active="true"] { border-color:#ffff00; color:#ffff00; background:rgba(255,255,0,.06); }

  /* Controls grid */
  #controls-grid {
    display:grid; grid-template-columns:repeat(5,1fr); gap:0 18px;
  }
  .ctrl-section { border-left:1px solid #181818; padding-left:14px; }
  .ctrl-section:first-child { border-left:none; padding-left:0; }

  .ctrl-row { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
  .ctrl-label { font-size:7px; color:#3a3a3a; letter-spacing:.2em; min-width:44px; text-transform:uppercase; }
  .toggle-row { display:flex; gap:4px; margin-top:6px; }

  /* Knobs */
  .knob-canvas { width:36px !important; height:36px !important; cursor:ns-resize; flex-shrink:0; }
  .knob-val    { font-size:8px; color:#555; letter-spacing:.08em; min-width:36px; }

  /* Select */
  .viz-select {
    font-size:8px; font-family:inherit; background:#080808;
    border:1px solid #222; color:#777; padding:3px 6px;
    cursor:pointer; flex:1; max-width:140px;
    letter-spacing:.05em; outline:none;
    min-height:28px;
  }
  .viz-select:focus { border-color:#444; }
  .viz-select option { background:#111; }
  .compact-select { width:auto; min-width:58px; max-width:96px; flex:0 0 auto; padding:3px 5px; }

  /* Engage/Stop */
  #start-btn, #stop-btn {
    font-size:8px; font-family:inherit; letter-spacing:.3em; text-transform:uppercase;
    padding:6px 12px; cursor:pointer; border:1px solid #ffff00; color:#ffff00;
    background:transparent; transition:all .2s; margin-top:8px; display:block;
  }
  #start-btn:hover { background:#ffff00; color:#000; }
  #stop-btn { border-color:#333; color:#444; }
  #stop-btn:hover { border-color:#a00; color:#a00; }
  #stop-btn.hidden { display:none; }
  #init-hint { font-size:7px; color:#2a2a2a; font-style:italic; margin-top:4px; display:block; }
  #perf-overlay {
    position:absolute; right:20px; top:46px; z-index:4; pointer-events:none;
    font-size:8px; line-height:1.7; letter-spacing:.18em; color:#777;
    background:rgba(0,0,0,.72); border:1px solid #222; padding:8px 10px;
    white-space:pre; display:none;
  }
  #perf-overlay.visible { display:block; }
  .visualizer-root.scope-only #hud-bar,
  .visualizer-root.scope-only #control-panel,
  .visualizer-root.scope-only #perf-overlay { display:none; }
  .visualizer-root.hud-hidden #hud-bar { display:none; }
  .visualizer-root.scope-only canvas#visualizer-canvas { background:#000; }

  @media (max-width: 900px) {
    #control-panel {
      max-height:min(72dvh, 620px);
      border-top:1px solid rgba(255,255,0,.08);
    }
    #panel-inner { padding:22px 14px calc(16px + env(safe-area-inset-bottom)); }
    #design-panel { grid-template-columns:1fr; }
    .panel-section { border-left:none; padding-left:0; border-top:1px solid #181818; padding-top:12px; }
    .panel-section:first-child { border-top:none; padding-top:0; }
    .primary-grid { grid-template-columns:repeat(3,minmax(80px,1fr)); }
    .design-knob { width:64px !important; height:64px !important; }
    .mode-btn, .osc-btn, .toggle-btn { font-size:8px; padding:8px 10px; min-height:34px; }
    .viz-select { min-height:34px; font-size:9px; }
  }

  @media (max-width: 560px) {
    #hud-bar { display:none; }
    #hud-title { font-size:8px; letter-spacing:.32em; }
    #status-label { font-size:7px; letter-spacing:.24em; }
    #panel-toggle-btn { font-size:8px; padding:6px 9px; }
    #control-panel { max-height:76dvh; }
    .primary-grid { grid-template-columns:repeat(2,minmax(118px,1fr)); gap:14px 10px; }
    #hud-center { display:none; }
    .panel-section summary { font-size:10px; margin-bottom:10px; }
    .design-label { font-size:10px; }
    .design-value { font-size:11px; }
    .mode-panel, .color-grid, #advanced-grid, .utility-strip { gap:9px; }
    .compact-select { max-width:100%; min-width:112px; }
    #design-start-btn, #design-stop-btn { min-height:36px; font-size:9px; padding:7px 12px; }
  }

  @media (max-width: 380px) {
    .primary-grid { grid-template-columns:1fr 1fr; }
    .design-knob { width:60px !important; height:60px !important; }
    .mode-btn, .osc-btn, .toggle-btn { letter-spacing:.16em; }
  }

  @media (max-height: 560px) and (orientation: landscape) {
    #control-panel { max-height:64dvh; }
    #panel-inner { padding-top:16px; }
    #design-panel { grid-template-columns:minmax(0,1.25fr) minmax(220px,.9fr) minmax(180px,.7fr); }
    .primary-grid { grid-template-columns:repeat(3,minmax(70px,1fr)); }
    .design-knob { width:50px !important; height:50px !important; }
    .panel-section summary { font-size:9px; margin-bottom:8px; }
  }
</style>

<script>
// ─────────────────────────────────────────────────────────
//  SS_SCOPE v4.0  —  Audio Visualizer Engine
// ─────────────────────────────────────────────────────────
const ROOT    = document.querySelector('.visualizer-root') as HTMLElement;
const canvas  = document.getElementById('visualizer-canvas') as HTMLCanvasElement;
const C       = canvas.getContext('2d')!;
const IS_MINI = ROOT.dataset.mini === 'true';
let ACCENT  = ROOT.dataset.color || '#ffff00';
let gridCanvas: HTMLCanvasElement | null = null;
let gridKey = '';

let renderScale = 1;
let dprClamp = 2;
function dpr() { return Math.min(window.devicePixelRatio || 1, dprClamp) * renderScale; }
function resize() {
  canvas.width  = canvas.clientWidth  * dpr();
  canvas.height = canvas.clientHeight * dpr();
  invalidateGrid();
}
window.addEventListener('resize', resize);
resize();

// ── Audio nodes ──────────────────────────────────────────
let audioCtx:    AudioContext;
let analyser:    AnalyserNode;
let gainNode:    GainNode;
let distNode:    WaveShaperNode;
let lpfNode:     BiquadFilterNode;
let hpfNode:     BiquadFilterNode;
let delayNode:   DelayNode;
let delayGain:   GainNode;
let outputGain:  GainNode;
let oscGainNode: GainNode;
let oscNode:     OscillatorNode | null = null;
let noiseNode:   AudioBufferSourceNode | null = null;
let micSource:   MediaStreamAudioSourceNode | null = null;
let micStream:   MediaStream | null = null;
let running = false;

// ── Audio params ─────────────────────────────────────────
let gain      = 1.0;
let outVol    = 0;
let oscType: OscillatorType | 'off' | 'noise' = 'off';
let oscFreq   = 440;
let oscDetune = 0;
let oscVol    = 0.3;
let distAmt   = 0;
let delayTime = 0.25;
let delayMix  = 0;
let lpfFreq   = 20000;
let hpfFreq   = 10;

// ── Vis params ───────────────────────────────────────────
let mode      = 'scope';
let zoom      = 1.0;
let vdiv      = 1.0;
let persist   = 0.15;
let trigLvl   = 0.0;
let showGrid  = true;
let trigSync  = false;
let invertSig = false;
let pixelMapOn = false;
let pxSize    = 4;
let pxThresh  = 0.15;
let pxOpacity = 0.7;
let pxGap     = 1;
let beamWidth = 1;
let intensity = 1;
let xExpand = 1;
let yExpand = 1;
let rotationDeg = 0;
let hue = 60;
let hudVisible = true;

// Performance params
let targetFps = IS_MINI ? 30 : 60;
let actualFps = 0;
let msFrame = 0;
let droppedFrames = 0;
let frameInterval = 1000 / targetFps;
let lastFrameAt = 0;
let fpsWindowAt = 0;
let fpsFrames = 0;
let sampleStep = IS_MINI ? 4 : 1;
let fftSetting: 'auto' | '512' | '1024' | '2048' | '4096' = 'auto';
let glowQuality: 'off' | 'low' | 'high' = IS_MINI ? 'off' : 'low';
let adaptiveQuality = false;
let perfOverlayOn = false;
let scopeOnly = false;
let ultraMinimal = false;
let lastHudAt = 0;
let hudPeakHz = 0;
let hudRmsDb = -Infinity;

// ── Buffers ──────────────────────────────────────────────
const WATERFALL_ROWS = 150;
let waterfallData: Uint8Array[] = [];
const LISS_LEN = 1024;
let lissX: number[] = [];
let lissY: number[] = [];
interface Ptcl { x:number;y:number;vx:number;vy:number;life:number;mLife:number;sz:number;hue:number }
let particles: Ptcl[] = [];

function setTargetFps(v: number) {
  targetFps = Math.max(1, v);
  frameInterval = 1000 / targetFps;
}

function glow(v: number) {
  if (glowQuality === 'off') return 0;
  return glowQuality === 'high' ? v : v * 0.35;
}

function setFftSize(size: number) {
  if (!analyser) return;
  analyser.fftSize = size;
  waterfallData = [];
}

function autoFftForMode() {
  if (fftSetting !== 'auto') return;
  const next =
    mode === 'spectrum' || mode === 'waterfall' ? 4096 :
    mode === 'particle' ? 1024 :
    2048;
  setFftSize(next);
}

function applyFftSetting() {
  if (fftSetting === 'auto') {
    autoFftForMode();
  } else {
    setFftSize(parseInt(fftSetting, 10));
  }
}

function invalidateGrid() {
  gridCanvas = null;
  gridKey = '';
}

function updatePerfHud(force = false) {
  const now = performance.now();
  if (!force && now - lastHudAt < 250) return;
  lastHudAt = now;

  const hz=(h:number)=>h>=1000?`${(h/1000).toFixed(1)}k`:`${Math.round(h)}`;
  const fe=document.getElementById('hud-freq');
  const re=document.getElementById('hud-rms');
  const pe=document.getElementById('hud-perf');
  const oe=document.getElementById('perf-overlay');
  if(fe) fe.textContent=`FREQ: ${hz(hudPeakHz)}Hz`;
  if(re) re.textContent=`RMS: ${isFinite(hudRmsDb)?hudRmsDb.toFixed(1):'-∞'}dB`;
  if(pe) pe.textContent=`FPS: ${actualFps.toFixed(0)}/${targetFps} | ${msFrame.toFixed(1)}ms | DROP ${droppedFrames}`;
  if(oe) {
    oe.classList.toggle('visible', perfOverlayOn);
    oe.textContent =
      `FPS ${actualFps.toFixed(1)} / ${targetFps}\n` +
      `FRAME ${msFrame.toFixed(1)}ms\n` +
      `SCALE ${renderScale.toFixed(2)} DPR ${dpr().toFixed(2)}\n` +
      `FFT ${analyser?.fftSize ?? '--'}\n` +
      `SAMPLES 1:${sampleStep}\n` +
      `GLOW ${glowQuality.toUpperCase()}\n` +
      `DROP ${droppedFrames}`;
  }
}

function applyAdaptiveQuality() {
  if (!adaptiveQuality || actualFps === 0) return;
  if (actualFps < targetFps * 0.72) {
    if (sampleStep < 8) sampleStep *= 2;
    if (glowQuality === 'high') glowQuality = 'low';
    else if (glowQuality === 'low') glowQuality = 'off';
    if (renderScale > 0.5) { renderScale = renderScale === 1 ? 0.75 : 0.5; resize(); }
  }
}

function hueColor(h: number) {
  return `hsl(${Math.round(h)},100%,58%)`;
}

function setAccentFromHue(v: number) {
  hue = ((v % 360) + 360) % 360;
  ACCENT = hueColor(hue);
  ROOT.dataset.color = ACCENT;
  const dot = document.getElementById('status-dot') as HTMLElement | null;
  if (dot) dot.style.background = ACCENT;
  invalidateGrid();
}

function fmtDesign(v: number, fmt: string) {
  switch(fmt) {
    case 'pct': return `${Math.round(v*100)}%`;
    case 'x1': return `${v.toFixed(1)}x`;
    case 'deg': return `${Math.round(v)}°`;
    default: return v.toFixed(2);
  }
}

function drawDesignKnob(kc: HTMLCanvasElement) {
  const min = parseFloat(kc.dataset.min || '0');
  const max = parseFloat(kc.dataset.max || '1');
  const val = parseFloat(kc.dataset.val || '0');
  const bipolar = kc.dataset.bipolar === 'true';
  const sz = kc.classList.contains('large-knob') ? 58 : 58;
  const D = dpr();
  kc.width = kc.height = sz * D;
  kc.style.width = kc.style.height = `${sz}px`;
  const ctx = kc.getContext('2d')!;
  ctx.setTransform(D,0,0,D,0,0);
  ctx.clearRect(0,0,sz,sz);
  const cx=sz/2, cy=sz/2, r=sz/2-5;
  const start=Math.PI*.75, sweep=Math.PI*1.5;
  const norm=Math.max(0,Math.min(1,(val-min)/(max-min)));
  const angle=start+norm*sweep;
  ctx.lineCap='round';
  ctx.beginPath();ctx.arc(cx,cy,r,start,start+sweep);ctx.strokeStyle='#1c1c1c';ctx.lineWidth=4;ctx.stroke();
  ctx.beginPath();
  if (bipolar && norm < .5) ctx.arc(cx,cy,r,angle,start+sweep*.5);
  else ctx.arc(cx,cy,r,bipolar ? start+sweep*.5 : start,angle);
  ctx.strokeStyle=ACCENT;ctx.shadowBlur=glow(10);ctx.shadowColor=ACCENT;ctx.lineWidth=4;ctx.stroke();
  ctx.shadowBlur=0;
  ctx.beginPath();ctx.arc(cx,cy,r*.42,0,Math.PI*2);ctx.strokeStyle='#2b2b2b';ctx.lineWidth=1;ctx.stroke();
  ctx.beginPath();ctx.arc(cx+Math.cos(angle)*r,cy+Math.sin(angle)*r,3,0,Math.PI*2);ctx.fillStyle='#fff';ctx.fill();
}

function applyDesignParam(id: string, v: number) {
  switch(id) {
    case 'design-volume': setOutputVol(v); break;
    case 'design-speed': zoom = v; break;
    case 'design-scale': vdiv = v; break;
    case 'design-beam': beamWidth = v; break;
    case 'design-intensity': intensity = v; break;
    case 'design-afterglow': persist = v; break;
    case 'design-x': xExpand = v; break;
    case 'design-y': yExpand = v; break;
    case 'design-rotate': rotationDeg = v; break;
    case 'design-hue': setAccentFromHue(v); break;
  }
}

function setScopeOnly(on: boolean) {
  scopeOnly = on;
  ROOT.classList.toggle('scope-only', scopeOnly);
  document.getElementById('scope-only-btn')?.setAttribute('data-active', String(scopeOnly));
  document.getElementById('design-wave-only')?.setAttribute('data-active', String(scopeOnly));
  if (scopeOnly) {
    mode = 'scope';
    showGrid = false;
    pixelMapOn = false;
    perfOverlayOn = false;
    document.querySelectorAll('.mode-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('[data-mode="scope"]').forEach(b=>b.classList.add('active'));
    document.getElementById('perf-overlay')?.classList.remove('visible');
    document.getElementById('design-pixelmap')?.setAttribute('data-active','false');
  }
  document.dispatchEvent(new CustomEvent('ss-scope-only', { detail: { active: scopeOnly } }));
}

function resetDesignParams() {
  const defaults: Record<string,string> = {
    'design-volume':'0',
    'design-speed':'1',
    'design-scale':'1',
    'design-beam':'1',
    'design-intensity':'1',
    'design-afterglow':'0.15',
    'design-x':'1',
    'design-y':'1',
    'design-rotate':'0',
    'design-hue':'60',
  };
  document.querySelectorAll('.design-knob').forEach(el=>{
    const kc = el as HTMLCanvasElement;
    const next = defaults[kc.dataset.id || ''];
    if (!next) return;
    kc.dataset.val = next;
    const fmt = kc.dataset.fmt || 'raw';
    const val = parseFloat(next);
    const lbl = document.querySelector(`.design-value[data-for="${kc.dataset.id}"]`) as HTMLElement | null;
    if (lbl) lbl.textContent = fmtDesign(val, fmt);
    drawDesignKnob(kc);
    applyDesignParam(kc.dataset.id!, val);
  });
  showGrid = true;
  pixelMapOn = false;
  glowQuality = 'low';
  sampleStep = 1;
  renderScale = 1;
  setTargetFps(60);
  resize();
}

function initDesignKnobs() {
  document.querySelectorAll('.design-knob').forEach(el=>{
    const kc = el as HTMLCanvasElement;
    const id = kc.dataset.id!;
    const lbl = document.querySelector(`.design-value[data-for="${id}"]`) as HTMLElement | null;
    const fmt = kc.dataset.fmt || 'raw';
    const min = parseFloat(kc.dataset.min || '0');
    const max = parseFloat(kc.dataset.max || '1');
    let startY = 0;
    let startVal = 0;
    let dragging = false;
    const setVal = (val: number) => {
      const next = Math.max(min, Math.min(max, val));
      kc.dataset.val = String(next);
      if (lbl) lbl.textContent = fmtDesign(next, fmt);
      drawDesignKnob(kc);
      applyDesignParam(id, next);
    };
    setVal(parseFloat(kc.dataset.val || '0'));
    const move = (clientY: number) => {
      const fine = window.event instanceof MouseEvent && window.event.shiftKey ? .001 : .004;
      setVal(startVal + (startY - clientY) * (max - min) * fine);
    };
    kc.addEventListener('mousedown',e=>{dragging=true;startY=e.clientY;startVal=parseFloat(kc.dataset.val||'0');e.preventDefault();});
    window.addEventListener('mousemove',e=>{if(dragging)move(e.clientY);});
    window.addEventListener('mouseup',()=>{dragging=false;});
    kc.addEventListener('touchstart',e=>{dragging=true;startY=e.touches[0].clientY;startVal=parseFloat(kc.dataset.val||'0');e.preventDefault();},{passive:false});
    window.addEventListener('touchmove',e=>{if(dragging)move(e.touches[0].clientY);},{passive:false});
    window.addEventListener('touchend',()=>{dragging=false;});
    kc.addEventListener('dblclick',()=>setVal(parseFloat(kc.dataset.id === 'design-afterglow' ? '0.15' : kc.dataset.id === 'design-hue' ? '60' : kc.dataset.id === 'design-volume' ? '0' : '1')));
  });
}

// ── Audio init ───────────────────────────────────────────
async function initAudio(deviceId?: string) {
  if (running) { await restartMic(deviceId); return; }
  try {
    micStream = await navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation:false, noiseSuppression:false, autoGainControl:false,
               ...(deviceId ? { deviceId:{ exact:deviceId } } : {}) }
    });
  } catch(e) { console.warn('Mic unavail:', e); }

  audioCtx    = new AudioContext();
  analyser    = audioCtx.createAnalyser();
  analyser.fftSize = 2048;
  analyser.smoothingTimeConstant = 0.0;
  applyFftSetting();

  gainNode    = audioCtx.createGain();           gainNode.gain.value    = gain;
  distNode    = audioCtx.createWaveShaper();     distNode.oversample    = '4x';
  lpfNode     = audioCtx.createBiquadFilter();   lpfNode.type           = 'lowpass';   lpfNode.frequency.value  = lpfFreq;
  hpfNode     = audioCtx.createBiquadFilter();   hpfNode.type           = 'highpass';  hpfNode.frequency.value  = hpfFreq;
  delayNode   = audioCtx.createDelay(2.0);       delayNode.delayTime.value = delayTime;
  delayGain   = audioCtx.createGain();           delayGain.gain.value   = 0;
  // Output path starts muted. OUT VOL controls this gain directly.
  outputGain  = audioCtx.createGain();           outputGain.gain.value  = 0;
  oscGainNode = audioCtx.createGain();           oscGainNode.gain.value = 0;

  applyDistortion(distAmt);

  // Signal chain:
  // [mic|osc] → gainNode → distNode → hpfNode → lpfNode → analyser
  //                                                        → delayNode → delayGain → analyser
  //                                           → outputGain → destination
  gainNode.connect(distNode);
  distNode.connect(hpfNode);
  hpfNode.connect(lpfNode);
  lpfNode.connect(analyser);
  lpfNode.connect(delayNode);
  delayNode.connect(delayGain);
  delayGain.connect(analyser);
  analyser.connect(outputGain);
  outputGain.connect(audioCtx.destination);

  oscGainNode.connect(gainNode);

  if (micStream) {
    micSource = audioCtx.createMediaStreamSource(micStream);
    micSource.connect(gainNode);
  }

  running = true;
  setEngageUI(true);
  requestAnimationFrame(drawLoop);
}

async function restartMic(deviceId?: string) {
  micStream?.getTracks().forEach(t => t.stop());
  micSource?.disconnect();
  try {
    micStream = await navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation:false, noiseSuppression:false, autoGainControl:false,
               ...(deviceId ? { deviceId:{ exact:deviceId } } : {}) }
    });
    micSource = audioCtx.createMediaStreamSource(micStream);
    micSource.connect(gainNode);
  } catch(e) { console.warn('Mic restart failed:', e); }
}

function stopAudio() {
  oscNode?.stop();   oscNode   = null;
  noiseNode?.stop(); noiseNode = null;
  micStream?.getTracks().forEach(t => t.stop());
  // Safely disconnect outputGain from destination if connected
  try { outputGain?.disconnect(audioCtx.destination); } catch(_){}
  audioCtx?.close();
  running = false;
  setEngageUI(false);
}

function setEngageUI(on: boolean) {
  const sl = document.getElementById('status-label');
  const sb = document.getElementById('start-btn');
  const xb = document.getElementById('stop-btn');
  const dsb = document.getElementById('design-start-btn');
  const dxb = document.getElementById('design-stop-btn');
  const ih = document.getElementById('init-hint');
  const dih = document.getElementById('design-init-hint');
  if (sl) sl.textContent = on ? 'ACTIVE' : 'STANDBY';
  sb?.classList.toggle('hidden', on);
  xb?.classList.toggle('hidden', !on);
  dsb?.classList.toggle('hidden', on);
  dxb?.classList.toggle('hidden', !on);
  if (ih && on) ih.textContent = micStream ? 'mic connected' : 'synth only';
  if (dih && on) dih.textContent = micStream ? 'mic connected' : 'synth only';
}

function setOutputVol(v: number) {
  outVol = v;
  if (outputGain) outputGain.gain.setTargetAtTime(v, audioCtx?.currentTime||0, 0.01);
}

// ── Distortion ───────────────────────────────────────────
function makeDistCurve(amount: number): Float32Array {
  const n = 512; const curve = new Float32Array(n);
  for (let i = 0; i < n; i++) {
    const x = (i*2)/n - 1;
    curve[i] = amount === 0 ? x : ((Math.PI+amount)*x)/(Math.PI+amount*Math.abs(x));
  }
  return curve;
}
function applyDistortion(v: number) { if (distNode) distNode.curve = makeDistCurve(v); }

// ── Oscillator ───────────────────────────────────────────
function startOsc(type: typeof oscType) {
  oscNode?.stop();   oscNode   = null;
  noiseNode?.stop(); noiseNode = null;
  if (!audioCtx || type === 'off') { oscGainNode?.gain.setTargetAtTime(0, audioCtx?.currentTime||0, 0.01); return; }
  if (type === 'noise') {
    const buf = audioCtx.createBuffer(1, audioCtx.sampleRate*2, audioCtx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < d.length; i++) d[i] = Math.random()*2-1;
    noiseNode = audioCtx.createBufferSource();
    noiseNode.buffer = buf; noiseNode.loop = true;
    noiseNode.connect(oscGainNode); noiseNode.start();
  } else {
    oscNode = audioCtx.createOscillator();
    oscNode.type = type as OscillatorType;
    oscNode.frequency.value = oscFreq;
    oscNode.detune.value    = oscDetune;
    oscNode.connect(oscGainNode); oscNode.start();
  }
  oscGainNode.gain.setTargetAtTime(oscVol, audioCtx.currentTime, 0.01);
}

// ── Device enumeration ───────────────────────────────────
async function populateDevices() {
  const sel = document.getElementById('input-select') as HTMLSelectElement;
  const designSel = document.getElementById('design-input-select') as HTMLSelectElement;
  if (!sel && !designSel) return;
  try {
    // Trigger permission prompt
    await navigator.mediaDevices.getUserMedia({audio:true}).then(s=>s.getTracks().forEach(t=>t.stop())).catch(()=>{});
    const devs = await navigator.mediaDevices.enumerateDevices();
    const ins  = devs.filter(d => d.kind === 'audioinput');
    const html = ins.map((d,i) => `<option value="${d.deviceId}">${d.label||'Microphone '+(i+1)}</option>`).join('');
    if (sel) sel.innerHTML = html;
    if (designSel) designSel.innerHTML = html;
  } catch {
    if (sel) sel.innerHTML = '<option value="">— permission required —</option>';
    if (designSel) designSel.innerHTML = '<option value="">— permission required —</option>';
  }
}

// ── Data getters ─────────────────────────────────────────
function getTime(): Uint8Array {
  const buf = new Uint8Array(analyser.fftSize);
  analyser.getByteTimeDomainData(buf);
  if (invertSig) for (let i=0; i<buf.length; i++) buf[i] = 255-buf[i];
  return buf;
}
function getFreq(): Uint8Array {
  const buf = new Uint8Array(analyser.frequencyBinCount);
  analyser.getByteFrequencyData(buf);
  return buf;
}
function findTrigger(data: Uint8Array): number {
  const mid = 128 + trigLvl*127;
  for (let i=1; i<data.length-1; i++) if (data[i-1]<mid && data[i]>=mid) return i;
  return 0;
}
function calcRMS(data: Uint8Array): number {
  let s=0;
  for (const v of data) { const n=(v-128)/128*gain; s+=n*n; }
  return Math.sqrt(s/data.length);
}
function peakIdx(freq: Uint8Array): number {
  let mi=0; for (let i=1; i<freq.length; i++) if (freq[i]>freq[mi]) mi=i; return mi;
}
function idxToHz(i: number): number { return i*(audioCtx?.sampleRate??44100)/analyser.fftSize; }

// ── Grid ─────────────────────────────────────────────────
function drawGrid(c: CanvasRenderingContext2D, W: number, H: number) {
  const key = `${Math.round(W)}x${Math.round(H)}:${ACCENT}`;
  if (!gridCanvas || gridKey !== key) {
    gridCanvas = document.createElement('canvas');
    gridCanvas.width = Math.max(1, Math.round(W));
    gridCanvas.height = Math.max(1, Math.round(H));
    gridKey = key;
    const g = gridCanvas.getContext('2d')!;
    g.strokeStyle='rgba(255,255,0,0.055)'; g.lineWidth=0.5;
    for(let i=0;i<=10;i++){const x=W/10*i;g.beginPath();g.moveTo(x,0);g.lineTo(x,H);g.stroke();}
    for(let j=0;j<=8;j++){const y=H/8*j;g.beginPath();g.moveTo(0,y);g.lineTo(W,y);g.stroke();}
    g.strokeStyle='rgba(255,255,0,0.11)';
    g.beginPath();g.moveTo(0,H/2);g.lineTo(W,H/2);g.stroke();
    g.beginPath();g.moveTo(W/2,0);g.lineTo(W/2,H);g.stroke();
  }
  c.drawImage(gridCanvas, 0, 0, W, H);
}

// ── Pixel Map ────────────────────────────────────────────
function drawPixelMap(c: CanvasRenderingContext2D, W: number, H: number) {
  const cell = Math.max(2, Math.floor(pxSize)) + Math.max(0, Math.floor(pxGap));
  let imgData: ImageData;
  try { imgData = c.getImageData(0, 0, Math.floor(W), Math.floor(H)); } catch { return; }
  const src = imgData.data;
  const iW  = imgData.width;

  // Clear canvas (we'll repaint as pixels)
  c.clearRect(0, 0, W, H);

  c.save();
  c.globalAlpha = pxOpacity;
  const dotSz = Math.max(1, pxSize - pxGap);
  const cols = Math.ceil(W / cell);
  const rows = Math.ceil(H / cell);

  for (let row=0; row<rows; row++) {
    for (let col=0; col<cols; col++) {
      const sx = Math.floor(col*cell + cell/2);
      const sy = Math.floor(row*cell + cell/2);
      if (sx >= iW || sy >= imgData.height) continue;
      const idx = (sy*iW + sx)*4;
      const r=src[idx], g=src[idx+1], b=src[idx+2], a=src[idx+3];
      const lum = (r*.299 + g*.587 + b*.114)/255 * (a/255);
      if (lum < pxThresh) continue;
      const t = Math.min(lum / 0.75, 1);
      const pr = Math.round(t>0.5 ? 255 : t*2*255);
      const pg = Math.round(Math.min(lum*1.6, 1)*255);
      const pb = Math.round(t>0.88 ? (t-0.88)/0.12*200 : 0);
      c.fillStyle = `rgb(${pr},${pg},${pb})`;
      c.fillRect(col*cell, row*cell, dotSz, dotSz);
    }
  }
  c.restore();
}

// ── SCOPE ────────────────────────────────────────────────
function drawScope(c: CanvasRenderingContext2D, W: number, H: number) {
  const data = getTime();
  if (showGrid) drawGrid(c, W, H);
  const start  = trigSync ? findTrigger(data) : 0;
  const visLen = Math.max(2, Math.floor(data.length / zoom));
  const points = Math.max(2, Math.ceil(visLen / sampleStep));

  const wave = (lw: number, blur: number, alpha: number) => {
    c.save(); c.lineWidth=lw*beamWidth; c.shadowBlur=glow(blur*intensity); c.shadowColor=ACCENT;
    c.strokeStyle=ACCENT; c.globalAlpha=Math.min(1,alpha*intensity); c.beginPath();
    for (let p=0; p<points; p++) {
      const i = Math.min(visLen - 1, p * sampleStep);
      const v = ((data[(start+i)%data.length]/128)-1)*gain*vdiv;
      const y = H/2 - v*H*0.42*yExpand;
      const x = points === 1 ? W/2 : ((p/(points-1)-0.5)*W*xExpand)+W/2;
      p===0 ? c.moveTo(x,y) : c.lineTo(x,y);
    }
    c.stroke(); c.restore();
  };
  wave(8, 32, 0.07);
  wave(2.5, 14, 0.22);
  wave(1.2, 5, 1.0);

  if (trigSync) {
    c.save(); c.strokeStyle='rgba(255,80,80,.4)'; c.setLineDash([4,4]);
    c.lineWidth=.5; c.beginPath();
    const ty = H/2 - trigLvl*H*0.42;
    c.moveTo(0,ty); c.lineTo(W,ty); c.stroke(); c.restore();
  }
  const freq=getFreq(); const rms=calcRMS(data);
  updateHUD(idxToHz(peakIdx(freq)), rms>0?20*Math.log10(rms):-Infinity);
}

// ── SPECTRUM ─────────────────────────────────────────────
function drawSpectrum(c: CanvasRenderingContext2D, W: number, H: number) {
  const freq = getFreq();
  if (showGrid) drawGrid(c, W, H);
  const bins = Math.min(Math.floor(freq.length/zoom), freq.length);
  const bw   = W / bins;
  for (let i=0; i<bins; i++) {
    const v = Math.min((freq[i]/255)*gain*vdiv, 1);
    const h = v*H*.95;
    const hue = (i/bins)*60+35;
    c.fillStyle=`hsla(${hue},${80+v*20}%,55%,${0.4+v*0.6})`;
    c.shadowBlur=glow(8*v); c.shadowColor=`hsl(${hue},100%,70%)`;
    c.fillRect(i*bw, H-h, Math.max(bw-.5,.5), h);
  }
  c.save(); c.strokeStyle='rgba(255,255,255,.2)'; c.lineWidth=.5; c.beginPath();
  for (let i=0; i<bins; i++) {
    const v=Math.min((freq[i]/255)*gain*vdiv,1);
    i===0?c.moveTo(i*bw,H-v*H*.95):c.lineTo(i*bw,H-v*H*.95);
  }
  c.stroke(); c.restore();
  updateHUD(idxToHz(peakIdx(freq)), 0);
}

// ── LISSAJOUS (line) ─────────────────────────────────────
function drawLissajous(c: CanvasRenderingContext2D, W: number, H: number) {
  const data = getTime();
  const step = Math.max(1, Math.floor(data.length/LISS_LEN));
  for (let i=0; i<data.length-step; i+=step) {
    lissX.push(((data[i]/128)-1)*gain*vdiv);
    lissY.push(((data[i+step]/128)-1)*gain*vdiv);
  }
  while (lissX.length > LISS_LEN) { lissX.shift(); lissY.shift(); }

  if (showGrid) {
    c.save(); c.strokeStyle='rgba(255,255,0,0.05)'; c.lineWidth=.5;
    [-0.5,0,0.5].forEach(v=>{
      c.beginPath();c.moveTo(W/2+v*W*.44,0);c.lineTo(W/2+v*W*.44,H);c.stroke();
      c.beginPath();c.moveTo(0,H/2+v*H*.44);c.lineTo(W,H/2+v*H*.44);c.stroke();
    }); c.restore();
  }

  const n = lissX.length;
  if (n < 2) return;
  for (let i=1; i<n; i++) {
    const t = i/n;
    c.save();
    c.strokeStyle=`hsla(${t*55+35},100%,60%,${t*.9})`;
    c.lineWidth=1.2; c.shadowBlur=glow(6*t); c.shadowColor=`hsl(${t*55+35},100%,70%)`;
    c.beginPath();
    c.moveTo(W/2+lissX[i-1]*W*.44, H/2+lissY[i-1]*H*.44);
    c.lineTo(W/2+lissX[i]  *W*.44, H/2+lissY[i]  *H*.44);
    c.stroke(); c.restore();
  }
  if (n>0) {
    c.save(); c.fillStyle=ACCENT; c.shadowBlur=glow(14); c.shadowColor=ACCENT;
    c.beginPath(); c.arc(W/2+lissX[n-1]*W*.44, H/2+lissY[n-1]*H*.44, 3, 0, Math.PI*2);
    c.fill(); c.restore();
  }
}

// ── RADIAL ───────────────────────────────────────────────
function drawRadial(c: CanvasRenderingContext2D, W: number, H: number) {
  const data=getTime(), freq=getFreq();
  const cx=W/2, cy=H/2, baseR=Math.min(W,H)*.26;
  if (showGrid) {
    c.save();
    [.5,1,1.5,2].forEach(s=>{
      c.beginPath();c.arc(cx,cy,baseR*s*.55,0,Math.PI*2);
      c.strokeStyle='rgba(255,255,0,0.04)';c.lineWidth=.5;c.stroke();
    }); c.restore();
  }
  const fBins=Math.min(freq.length,128);
  c.save();
  for (let i=0;i<fBins;i++) {
    const v=Math.min((freq[i]/255)*gain*vdiv,1);
    const ang=i*(Math.PI*2/fBins)-Math.PI/2;
    const hue=(i/fBins)*60+30;
    c.strokeStyle=`hsla(${hue},100%,58%,${.4+v*.6})`;
    c.shadowColor=`hsl(${hue},100%,70%)`;c.shadowBlur=glow(8*v);c.lineWidth=1.5;
    c.beginPath();
    c.moveTo(cx+Math.cos(ang)*baseR*.12, cy+Math.sin(ang)*baseR*.12);
    c.lineTo(cx+Math.cos(ang)*(baseR*.12+v*baseR*.65), cy+Math.sin(ang)*(baseR*.12+v*baseR*.65));
    c.stroke();
  } c.restore();

  const wBins=Math.min(data.length,512), wStep=Math.PI*2/wBins;
  const ring=(lw:number,blur:number,alpha:number)=>{
    c.save();c.strokeStyle=ACCENT;c.lineWidth=lw;c.shadowBlur=glow(blur);c.shadowColor=ACCENT;c.globalAlpha=alpha;
    c.beginPath();
    for(let i=0;i<wBins;i++){
      const v=((data[i]/128)-1)*gain*vdiv;
      const r=baseR+v*baseR*.55, ang=i*wStep-Math.PI/2;
      i===0?c.moveTo(cx+Math.cos(ang)*r,cy+Math.sin(ang)*r):c.lineTo(cx+Math.cos(ang)*r,cy+Math.sin(ang)*r);
    }
    c.closePath();c.stroke();c.restore();
  };
  ring(6,28,.1); ring(1.5,8,1);
  const rms=calcRMS(data);
  c.save();c.beginPath();c.arc(cx,cy,3+rms*18,0,Math.PI*2);
  c.fillStyle=ACCENT;c.shadowBlur=glow(20);c.shadowColor=ACCENT;c.fill();c.restore();
  updateHUD(idxToHz(peakIdx(freq)),0);
}

// ── WATERFALL ────────────────────────────────────────────
function drawWaterfall(c: CanvasRenderingContext2D, W: number, H: number) {
  const freq=getFreq();
  waterfallData.unshift(new Uint8Array(freq));
  if (waterfallData.length>WATERFALL_ROWS) waterfallData.pop();
  const rH=H/WATERFALL_ROWS, bins=freq.length;
  for (let row=0;row<waterfallData.length;row++) {
    const d=waterfallData[row];
    for (let i=0;i<bins;i++) {
      const v=Math.min((d[i]/255)*gain*vdiv,1);
      let r=0,g=0,b=0;
      if(v<.25){r=v*4*160;}
      else if(v<.5){r=160+(v-.25)*4*95;g=(v-.25)*4*130;}
      else if(v<.75){r=255;g=130+(v-.5)*4*125;}
      else{r=255;g=255;b=(v-.75)*4*255;}
      c.fillStyle=`rgb(${Math.floor(r)},${Math.floor(g)},${Math.floor(b)})`;
      c.fillRect((i/bins)*W, row*rH, W/bins+.5, rH+.5);
    }
  }
  const sr=audioCtx?.sampleRate??44100;
  c.save();c.fillStyle='rgba(255,255,255,.3)';c.font='9px monospace';
  [100,500,1000,5000,10000].forEach(hz=>{
    const x=(hz/(sr/2))*W;if(x<W-30)c.fillText(hz>=1000?`${hz/1000}k`:`${hz}`,x+2,12);
  });c.restore();
  updateHUD(idxToHz(peakIdx(freq)),0);
}

// ── PARTICLE ─────────────────────────────────────────────
function drawParticles(c: CanvasRenderingContext2D, W: number, H: number) {
  const data=getTime(), freq=getFreq(), rms=calcRMS(data);
  if (showGrid) drawGrid(c,W,H);
  const count=Math.floor(rms*40);
  for(let i=0;i<count;i++){
    const ang=Math.random()*Math.PI*2, sp=1+Math.random()*5*rms;
    particles.push({x:W/2+(Math.random()-.5)*W*.4,y:H/2+(Math.random()-.5)*H*.4,
      vx:Math.cos(ang)*sp,vy:Math.sin(ang)*sp,life:1,mLife:.4+Math.random()*1.2,
      sz:1+Math.random()*3*rms,hue:35+Math.random()*50});
  }
  particles=particles.filter(p=>p.life>0);
  for(const p of particles){
    p.x+=p.vx;p.y+=p.vy;p.vy+=.06;p.life-=.016/p.mLife;
    c.save();c.globalAlpha=Math.max(0,p.life);c.beginPath();c.arc(p.x,p.y,p.sz,0,Math.PI*2);
    c.fillStyle=`hsl(${p.hue},100%,65%)`;c.shadowBlur=glow(10);c.shadowColor=`hsl(${p.hue},100%,70%)`;
    c.fill();c.restore();
  }
  c.save();c.strokeStyle='rgba(255,255,0,.2)';c.lineWidth=1;c.shadowBlur=glow(6);c.shadowColor=ACCENT;c.beginPath();
  for(let i=0;i<data.length;i+=sampleStep){
    const v=((data[i]/128)-1)*gain*vdiv;
    const y=H/2-v*H*.38;i===0?c.moveTo(0,y):c.lineTo((i/data.length)*W,y);
  }c.stroke();c.restore();
  updateHUD(idxToHz(peakIdx(freq)),0);
}

// ── HUD ──────────────────────────────────────────────────
function updateHUD(peakHz: number, rmsDb: number) {
  const hz=(h:number)=>h>=1000?`${(h/1000).toFixed(1)}k`:`${Math.round(h)}`;
  const fe=document.getElementById('hud-freq');
  const re=document.getElementById('hud-rms');
  if(fe) fe.textContent=`FREQ: ${hz(peakHz)}Hz`;
  if(re) re.textContent=`RMS: ${isFinite(rmsDb)?rmsDb.toFixed(1):'-∞'}dB`;
}

// ── DRAW LOOP ────────────────────────────────────────────
function drawLoop(now = 0) {
  if (!running) return;
  requestAnimationFrame(drawLoop);
  if (document.hidden) return;
  if (!lastFrameAt) lastFrameAt = now;
  const elapsed = now - lastFrameAt;
  if (elapsed < frameInterval * 0.92) return;
  msFrame = elapsed;
  if (elapsed > frameInterval * 1.7) droppedFrames++;
  lastFrameAt = now - (elapsed % frameInterval);
  fpsFrames++;
  if (!fpsWindowAt) fpsWindowAt = now;
  if (now - fpsWindowAt >= 500) {
    actualFps = fpsFrames * 1000 / (now - fpsWindowAt);
    fpsFrames = 0;
    fpsWindowAt = now;
    applyAdaptiveQuality();
    updatePerfHud(true);
  }
  const W=canvas.width, H=canvas.height, D=dpr(), Wl=W/D, Hl=H/D;

  if (IS_MINI) {
    C.clearRect(0,0,W,H);
    if (!analyser) return;
    const d=getTime();
    C.save();C.scale(D,D);C.lineWidth=1;C.strokeStyle=ACCENT;C.shadowBlur=glow(4);C.shadowColor=ACCENT;C.beginPath();
    for(let i=0;i<d.length;i+=sampleStep){
      const v=((d[i]/128)-1)*gain*vdiv;
      const y=Hl/2-v*Hl*.42;i===0?C.moveTo(0,y):C.lineTo((i/d.length)*Wl,y);
    }C.stroke();C.restore();
    return;
  }

  // Phosphor persistence
  C.fillStyle=`rgba(0,0,0,${ultraMinimal ? 1 : 1-persist})`;C.fillRect(0,0,W,H);

  C.save();C.scale(D,D);
  if (rotationDeg !== 0) {
    C.translate(Wl/2,Hl/2);
    C.rotate(rotationDeg*Math.PI/180);
    C.translate(-Wl/2,-Hl/2);
  }
  switch(mode){
    case'scope':     drawScope(C,Wl,Hl);     break;
    case'spectrum':  drawSpectrum(C,Wl,Hl);  break;
    case'lissajous': drawLissajous(C,Wl,Hl); break;
    case'radial':    drawRadial(C,Wl,Hl);    break;
    case'waterfall': drawWaterfall(C,Wl,Hl); break;
    case'particle':  drawParticles(C,Wl,Hl); break;
  }
  if (pixelMapOn) drawPixelMap(C,Wl,Hl);
  C.restore();
}

// ── DEMO LOOP ────────────────────────────────────────────
let demoT=0;
let demoLastAt=0;
function demoLoop(now=0){
  if(running) return;
  requestAnimationFrame(demoLoop);
  if(document.hidden) return;
  if(!demoLastAt) demoLastAt=now;
  const elapsed=now-demoLastAt;
  if(elapsed<frameInterval*.92) return;
  demoLastAt=now-(elapsed%frameInterval);
  const W=canvas.width,H=canvas.height,D=dpr(),Wl=W/D,Hl=H/D;
  demoT+=.018;
  C.fillStyle='rgba(0,0,0,.25)';C.fillRect(0,0,W,H);
  C.save();C.scale(D,D);
  if(!IS_MINI&&showGrid) drawGrid(C,Wl,Hl);
  C.strokeStyle=ACCENT;C.shadowBlur=glow(8);C.shadowColor=ACCENT;C.lineWidth=IS_MINI?1:1.4;
  C.beginPath();
  const pts=IS_MINI?96:Math.max(128,Math.floor(1024/sampleStep));
  for(let i=0;i<pts;i++){
    const t=demoT+i*.035;
    const y=Hl/2+Math.sin(t)*Hl*.28+Math.sin(t*2.7+.5)*Hl*.07+Math.sin(t*7.1)*Hl*.02;
    i===0?C.moveTo(0,y):C.lineTo((i/pts)*Wl,y);
  }C.stroke();
  if(!IS_MINI&&pixelMapOn) drawPixelMap(C,Wl,Hl);
  C.restore();
}

// ─────────────────────────────────────────────────────────
// KNOB ENGINE
// ─────────────────────────────────────────────────────────
interface KnobState{min:number;max:number;val:number;fmt:string;log:boolean;bipolar:boolean}
const knobs=new Map<string,KnobState>();

function fmtKnob(id:string,v:number,fmt:string):string{
  switch(fmt){
    case'pct':return`${Math.round(v*100)}%`;
    case'x1': return`${v.toFixed(1)}×`;
    case'x2': return`${v.toFixed(2)}×`;
    case'hz':return v>=1000?`${(v/1000).toFixed(1)}kHz`:`${Math.round(v)}Hz`;
    case's':  return v>=1?`${v.toFixed(2)}s`:`${Math.round(v*1000)}ms`;
    case'raw':return`${Math.round(v)}`;
    case'ct': return`${v>0?'+':''}${Math.round(v)}¢`;
    default:  return v.toFixed(2);
  }
}

function drawKnob(kc:HTMLCanvasElement, s:KnobState){
  const sz=36, D=dpr();
  kc.width=kc.height=sz*D;
  kc.style.width=kc.style.height=sz+'px';
  const ctx=kc.getContext('2d')!;
  ctx.clearRect(0,0,sz*D,sz*D);
  ctx.scale(D,D);
  const cx=sz/2, cy=sz/2, r=sz/2-3.5;
  const START=Math.PI*.75, SWEEP=Math.PI*1.5;

  let norm: number;
  if(s.log&&s.min>0){
    norm=Math.log(s.val/s.min)/Math.log(s.max/s.min);
  }else{
    norm=(s.val-s.min)/(s.max-s.min);
  }
  norm=Math.max(0,Math.min(1,norm));
  const angle=START+norm*SWEEP;

  // Track background
  ctx.beginPath();ctx.arc(cx,cy,r,START,START+SWEEP);
  ctx.strokeStyle='#1a1a1a';ctx.lineWidth=3;ctx.lineCap='round';ctx.stroke();

  // Track fill
  const fillStart=s.bipolar?START+SWEEP*.5:START;
  const fillEnd=angle;
  if(s.bipolar&&norm<.5){
    ctx.beginPath();ctx.arc(cx,cy,r,fillEnd,fillStart);
  }else{
    ctx.beginPath();ctx.arc(cx,cy,r,fillStart,fillEnd);
  }
  ctx.strokeStyle=ACCENT;ctx.lineWidth=3;ctx.lineCap='round';
  ctx.shadowBlur=6;ctx.shadowColor=ACCENT;ctx.stroke();

  // Tick marks (12 divisions)
  ctx.shadowBlur=0;
  for(let i=0;i<=12;i++){
    const a=START+i*(SWEEP/12);
    const inner=r-5, outer=r+1;
    ctx.beginPath();
    ctx.moveTo(cx+Math.cos(a)*inner,cy+Math.sin(a)*inner);
    ctx.lineTo(cx+Math.cos(a)*outer,cy+Math.sin(a)*outer);
    ctx.strokeStyle=i%3===0?'#333':'#1e1e1e';ctx.lineWidth=.5;ctx.stroke();
  }

  // Pointer dot
  ctx.beginPath();ctx.arc(cx+Math.cos(angle)*r,cy+Math.sin(angle)*r,2.5,0,Math.PI*2);
  ctx.fillStyle='#fff';ctx.shadowBlur=5;ctx.shadowColor='#fff';ctx.fill();

  // Center circle
  ctx.shadowBlur=0;
  ctx.beginPath();ctx.arc(cx,cy,r*.3,0,Math.PI*2);
  ctx.strokeStyle='#252525';ctx.lineWidth=1;ctx.stroke();
}

function initKnobs(){
  document.querySelectorAll('.knob-canvas').forEach(el=>{
    const kc=el as HTMLCanvasElement;
    const id=kc.dataset.id!;
    const s:KnobState={
      min:parseFloat(kc.dataset.min||'0'),
      max:parseFloat(kc.dataset.max||'1'),
      val:parseFloat(kc.dataset.val||'0'),
      fmt:kc.dataset.fmt||'raw',
      log:kc.dataset.log==='true',
      bipolar:kc.dataset.bipolar==='true',
    };
    knobs.set(id,s);
    drawKnob(kc,s);
    const lbl=document.querySelector(`.knob-val[data-for="${id}"]`) as HTMLElement;
    if(lbl) lbl.textContent=fmtKnob(id,s.val,s.fmt);

    let startY=0, startVal=0, dragging=false;

    const onMove=(clientY:number)=>{
      const dy=startY-clientY;
      const range=s.max-s.min;
      let newVal:number;
      if(s.log&&s.min>0){
        const logR=Math.log(s.max/s.min);
        newVal=startVal*Math.exp(dy*.005*logR);
      }else{
        newVal=startVal+dy*range*.004;
      }
      newVal=Math.max(s.min,Math.min(s.max,newVal));
      s.val=newVal;
      drawKnob(kc,s);
      if(lbl) lbl.textContent=fmtKnob(id,s.val,s.fmt);
      applyKnob(id,newVal);
    };

    kc.addEventListener('mousedown',e=>{dragging=true;startY=e.clientY;startVal=s.val;e.preventDefault();});
    window.addEventListener('mousemove',e=>{if(dragging)onMove(e.clientY);});
    window.addEventListener('mouseup',()=>{dragging=false;});
    kc.addEventListener('touchstart',e=>{dragging=true;startY=e.touches[0].clientY;startVal=s.val;e.preventDefault();},{passive:false});
    window.addEventListener('touchmove',e=>{if(dragging)onMove(e.touches[0].clientY);});
    window.addEventListener('touchend',()=>{dragging=false;});
    kc.addEventListener('wheel',e=>{
      e.preventDefault();
      const delta=-Math.sign(e.deltaY)*(s.max-s.min)*.025;
      s.val=Math.max(s.min,Math.min(s.max,s.val+delta));
      drawKnob(kc,s);
      if(lbl) lbl.textContent=fmtKnob(id,s.val,s.fmt);
      applyKnob(id,s.val);
    },{passive:false});
  });
}

function applyKnob(id:string,v:number){
  const t=audioCtx?.currentTime||0;
  const ramp=(n:AudioParam,val:number)=>n.setTargetAtTime(val,t,.01);
  switch(id){
    case'gain':       gain=v;     if(gainNode)    ramp(gainNode.gain,v);          break;
    case'out-vol':    setOutputVol(v);                                             break;
    case'zoom':       zoom=v;                                                      break;
    case'vdiv':       vdiv=v;                                                      break;
    case'persist':    persist=v;                                                   break;
    case'triglvl':    trigLvl=v;                                                   break;
    case'osc-freq':   oscFreq=v;   if(oscNode)    ramp(oscNode.frequency,v);       break;
    case'osc-detune': oscDetune=v; if(oscNode)    ramp(oscNode.detune,v);          break;
    case'osc-vol':    oscVol=v;    if(oscGainNode) ramp(oscGainNode.gain,v);       break;
    case'dist':       distAmt=v;   applyDistortion(v);                             break;
    case'delay-time': delayTime=v; if(delayNode)  ramp(delayNode.delayTime,v);    break;
    case'delay-mix':  delayMix=v;  if(delayGain)  ramp(delayGain.gain,v*.7);      break;
    case'lpf':        lpfFreq=v;   if(lpfNode)    ramp(lpfNode.frequency,v);      break;
    case'hpf':        hpfFreq=v;   if(hpfNode)    ramp(hpfNode.frequency,v);      break;
    case'px-size':    pxSize=v;                                                    break;
    case'px-thresh':  pxThresh=v;                                                  break;
    case'px-opacity': pxOpacity=v;                                                 break;
    case'px-gap':     pxGap=v;                                                     break;
  }
}

